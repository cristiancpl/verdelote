---
import Base from '../layouts/Base.astro';
import { url } from '../lib/format';
---

<Base title="Página no encontrada" noindex>
  <section class="wrap" style="padding: 96px var(--gutter); text-align: center;">
    <h1 style="font-size: 2.5rem; letter-spacing: -0.03em; margin: 0;">Este camino no lleva a ningún lote</h1>
    <p style="margin: 24px 0 0;"><a class="btn btn-primary" href={url()}>Volver al inicio</a></p>
  </section>
</Base>
