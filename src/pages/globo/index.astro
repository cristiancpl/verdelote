---
// El globo ahora es el inicio. Los enlaces viejos /globo/#lote siguen funcionando: se reenvían con su hash
import { url } from '../../lib/format';
const destino = url();
---

<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <link rel="canonical" href={destino} />
    <title>AM Grupo Inmobiliario</title>
    <script is:inline define:vars={{ destino }}>
      location.replace(destino + location.hash);
    </script>
  </head>
  <body></body>
</html>
