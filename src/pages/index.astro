---
// Inicio de AM Grupo Inmobiliario, el globo 3D: el comprador navega un globo 3D fotorrealista (gmp-map-3d) hasta cada lote.
// Llegada con el planeta girando, zonas de Antioquia, lotes con precio corto, ficha lateral y recorrido en video.
// La clave sale de PUBLIC_GOOGLE_MAPS_KEY (.env, fuera de git). Sin clave o sin WebGL queda la lista de lotes
import { existsSync, readFileSync } from 'node:fs';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { formatArea, nombreCorto, url } from '../lib/format';
import { textoArea, textoPrecio, textoPrecioCorto, textoPrecioDetalle, tieneRecorrido } from '../lib/lote';
import { zonaDe } from '../lib/zonas';

const entradas = (await getCollection('lotes')).sort((a, b) => a.data.orden - b.data.orden);

/** Lindero dibujado en el globo (public/capas/lindero-<id>.geojson) como [{lat, lng}] */
const lindero = (id: string) => {
  const ruta = new URL(`../../public/capas/lindero-${id}.geojson`, import.meta.url);
  if (!existsSync(ruta)) return [];
  const geo = JSON.parse(readFileSync(ruta, 'utf-8'));
  return (geo.features[0].geometry.coordinates[0] as number[][]).slice(0, -1).map(([lng, lat]) => ({ lat, lng }));
};

/** Centro del lindero; el marcador y la órbita giran alrededor de él */
const centro = (pts: { lat: number; lng: number }[]) =>
  pts.length >= 3
    ? { lat: pts.reduce((s, p) => s + p.lat, 0) / pts.length, lng: pts.reduce((s, p) => s + p.lng, 0) / pts.length }
    : undefined;

const lotes = await Promise.all(
  entradas
    .filter((l) => l.data.mapa?.lat !== undefined || l.data.coordenadas)
    .map(async (l) => {
      const d = l.data;
      const contorno = lindero(l.id);
      const medio = centro(contorno);
      const video = d.video_completo ?? (d.vuelo ? { src: d.vuelo.src, poster: d.vuelo.poster } : undefined);
      return {
        id: l.id,
        d,
        zona: zonaDe(d.municipio),
        corto: nombreCorto(d.nombre),
        whatsapp: d.contacto
          ? `https://wa.me/${d.contacto.whatsapp}?text=${encodeURIComponent(
              `Hola ${d.contacto.nombre}, vi el ${d.nombre} en AM Grupo Inmobiliario y quiero agendar una visita`,
            )}`
          : undefined,
        ruta:
          d.coordenadas && !d.demo
            ? `https://www.google.com/maps/dir/?api=1&destination=${d.coordenadas.lat},${d.coordenadas.lon}`
            : undefined,
        video: video ? { src: url(video.src), poster: (await getImage({ src: video.poster, width: 1280 })).src } : undefined,
        cliente: {
          id: l.id,
          nombre: nombreCorto(d.nombre),
          municipio: d.municipio,
          departamento: d.departamento,
          vereda: d.vereda,
          areaTxt: textoArea(d),
          zona: zonaDe(d.municipio),
          // Lotes reales del proyecto (parcelación); un predio sin unidades cuenta como 1
          unidades: d.unidades.length || 1,
          lat: medio?.lat ?? d.mapa?.lat ?? d.coordenadas!.lat,
          lng: medio?.lng ?? d.mapa?.lon ?? d.coordenadas!.lon,
          alt: d.mapa?.alt ?? 0,
          camara: d.mapa?.camara,
          area: d.area_m2,
          precio: d.precio_cop ?? 0,
          precioCorto: textoPrecioCorto(d),
          estado: d.estado,
          demo: d.demo,
          recorrido: tieneRecorrido(d),
          lindero: contorno,
        },
      };
    }),
);

// Respaldo sin 3D: último cuadro del vuelo publicado como fondo de la llegada
const conVuelo = entradas.find((l) => l.data.vuelo);
const fondo = conVuelo ? await getImage({ src: conVuelo.data.vuelo!.final, width: 1920, format: 'webp' }) : undefined;

/** "3 proyectos · 10 lotes" cuando hay parcelaciones; "1 lote" o "4 lotes" cuando cada proyecto es un solo lote */
const conteoTxt = (proyectos: number, lotes: number) =>
  lotes > proyectos
    ? `${proyectos === 1 ? '1 proyecto' : `${proyectos} proyectos`} · ${lotes} lotes`
    : lotes === 1
      ? '1 lote'
      : `${lotes} lotes`;
const unidadesDe = (xs: { cliente: { unidades: number } }[]) => xs.reduce((s, l) => s + l.cliente.unidades, 0);

const municipios = [...new Set(lotes.map((l) => l.d.municipio))].sort((a, b) => a.localeCompare(b, 'es'));
const zonas = [...new Map(lotes.map((l) => [l.zona.id, l.zona])).values()];

// Países y regiones con lotes: son los únicos con contorno y nombre en el globo (capas en public/capas/<nombre>.geojson).
// El esquema no guarda el país: hoy todos los lotes están en Colombia
const slugCapa = (n: string) => n.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().replace(/\s+/g, '-');
const territorios = [
  { nombre: 'Colombia', tipo: 'pais' as const },
  ...[...new Set(lotes.map((l) => l.d.departamento))].map((nombre) => ({ nombre, tipo: 'region' as const })),
]
  .map((t) => ({ ...t, capa: slugCapa(t.nombre) }))
  .filter((t) => existsSync(new URL(`../../public/capas/${t.capa}.geojson`, import.meta.url)));

const config = {
  key: import.meta.env.PUBLIC_GOOGLE_MAPS_KEY ?? '',
  territorios,
  capas: url('capas/'),
  fichas: url('lotes/'),
  dibujo: import.meta.env.DEV,
  guardar: url('__lindero'),
  lotes: lotes.map((l) => l.cliente),
};
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');
---

<Base
  description="Navega Antioquia en 3D, vuela hasta cada lote y mira el terreno desde el aire antes de visitarlo"
  nav="overlay"
>
  <div class="globo" data-globo data-vista="llegada">
    <div class="lienzo" data-lienzo role="region" aria-label="Globo 3D con los lotes de AM Grupo Inmobiliario"></div>
    {fondo && <img class="fondo" src={fondo.src} alt="" data-fondo hidden />}

    <div class="etapa" data-etapa aria-live="polite">
      <strong data-etapa-titulo></strong>
      <span data-etapa-sub></span>
    </div>

    <section class="llegada" data-llegada aria-labelledby="llegada-titulo">
      <h1 id="llegada-titulo">Tu pedacito de mundo. <span>Elígelo desde el cielo.</span></h1>
      <p>Recorre Colombia en 3D y conoce cada terreno antes de pisarlo</p>
      <div class="acciones">
        <button class="btn btn-primary" type="button" data-explorar>
          Explorar lotes <Icon name="arrow-right" />
        </button>
        <a class="btn btn-glass" href={url('lotes/')}>Ver en lista</a>
      </div>
      <p class="respaldo-aviso" data-respaldo-aviso hidden>
        El 3D no está disponible en este navegador. Todos los lotes siguen en la lista
      </p>
    </section>

    <button class="pildora omitir" type="button" data-omitir>
      Omitir <Icon name="arrow-right" />
    </button>
    <button class="pildora lista-btn" type="button" data-lista-btn>
      <Icon name="list" /> Lista
    </button>

    <aside class="rail" data-rail aria-label="Lotes">
      <div class="rail-top">
        <nav class="migas" aria-label="Ubicación en el globo">
          <button type="button" class="miga" data-ir-antioquia><Icon name="globe-hemisphere-west" />Antioquia</button>
          <span class="miga-zona" data-miga-zona hidden></span>
        </nav>
        <button class="icon-btn rail-toggle" type="button" data-rail-toggle aria-expanded="true" aria-label="Mostrar u ocultar la lista">
          <Icon name="list" />
        </button>
      </div>

      <div class="buscar">
        <label class="sr" for="buscar-lote">Buscar lote por nombre o municipio</label>
        <Icon name="magnifying-glass" />
        <input id="buscar-lote" type="search" placeholder="Buscar lote" autocomplete="off" data-buscar />
        <button class="filtros-btn" type="button" data-filtros-toggle aria-expanded="false" aria-controls="filtros">
          <Icon name="sliders-horizontal" /><span>Filtros</span><span class="n" data-filtros-n hidden></span>
        </button>
      </div>

      <div class="filtros" id="filtros" data-filtros hidden>
        <label>
          <span>Municipio</span>
          <select data-f-municipio>
            <option value="">Todos</option>
            {municipios.map((m) => <option value={m}>{m}</option>)}
          </select>
        </label>
        <label>
          <span>Área mínima</span>
          <select data-f-area>
            <option value="">Cualquiera</option>
            <option value="2000">2.000 m²</option>
            <option value="3000">3.000 m²</option>
            <option value="5000">5.000 m²</option>
          </select>
        </label>
        <label>
          <span>Precio máximo</span>
          <select data-f-precio>
            <option value="">Cualquiera</option>
            <option value="250000000">$250 M</option>
            <option value="300000000">$300 M</option>
            <option value="400000000">$400 M</option>
          </select>
        </label>
        <label class="check">
          <input type="checkbox" data-f-recorrido />
          <span>Solo con recorrido en video</span>
        </label>
      </div>

      <p class="conteo" data-conteo aria-live="polite">{conteoTxt(lotes.length, unidadesDe(lotes))}</p>

      <div class="lista" data-lista>
        {
          zonas.map((z) => (
            <section class="grupo" data-grupo={z.id}>
              <button type="button" class="grupo-titulo" data-ir-zona={z.id}>
                {z.nombre}
                <span data-grupo-n>{conteoTxt(lotes.filter((l) => l.zona.id === z.id).length, unidadesDe(lotes.filter((l) => l.zona.id === z.id)))}</span>
              </button>
              <ul>
                {lotes
                  .filter((l) => l.zona.id === z.id)
                  .map((l) => (
                    <li data-item={l.id}>
                      <button type="button" class="item" data-abrir={l.id}>
                        {l.d.portada ? (
                          <Image src={l.d.portada} alt="" widths={[112, 224]} sizes="56px" class="thumb" />
                        ) : (
                          <span class="thumb vacio">
                            <Icon name="mountains" />
                          </span>
                        )}
                        <span class="item-txt">
                          <strong>{l.corto}</strong>
                          <span>{l.d.demo ? `${l.d.municipio}, demo` : l.d.municipio}</span>
                        </span>
                        <span class="item-num">
                          <strong>{textoPrecioCorto(l.d)}</strong>
                          <span>{textoArea(l.d)}</span>
                        </span>
                      </button>
                    </li>
                  ))}
              </ul>
            </section>
          ))
        }
        <div class="vacio-lista" data-vacio hidden>
          <p>Ningún lote cumple esos filtros</p>
          <button class="btn btn-ghost btn-sm" type="button" data-limpiar>Limpiar filtros</button>
        </div>
      </div>
    </aside>

    <aside class="ficha" data-ficha aria-label="Ficha del lote" hidden>
      {
        lotes.map((l) => (
          <article data-ficha-lote={l.id} hidden aria-labelledby={`ficha-${l.id}`}>
            <button class="icon-btn cerrar" type="button" data-volver aria-label="Volver al mapa">
              <Icon name="x" />
            </button>
            <div class="foto">
              {l.d.portada ? (
                <Image src={l.d.portada} alt={l.d.galeria[0]?.alt ?? l.d.nombre} widths={[400, 760]} sizes="(max-width: 767px) 100vw, 384px" />
              ) : (
                <div class="foto-vacia">
                  <Icon name="image" />
                  <span>Lote de demostración, sin fotos</span>
                </div>
              )}
            </div>
            <div class="cuerpo">
              <p class="lugar">
                <Icon name="map-pin" />
                {[l.d.vereda, l.d.municipio].filter(Boolean).join(', ')}
              </p>
              <h2 id={`ficha-${l.id}`}>{l.corto}</h2>
              <p class="tagline">{l.d.tagline}</p>

              <div class="precio">
                <strong>{textoPrecio(l.d)}</strong>
                <span>{textoPrecioDetalle(l.d)}</span>
              </div>

              <dl class="cifras">
                <div>
                  <dt>{l.d.area_max_m2 ? 'Por lote' : 'Área'}</dt>
                  <dd>{textoArea(l.d)}</dd>
                </div>
                {l.d.explanacion_m2 && (
                  <div>
                    <dt>Explanación</dt>
                    <dd>{formatArea(l.d.explanacion_m2)}</dd>
                  </div>
                )}
                <div>
                  <dt>Estado</dt>
                  <dd class:list={['estado', l.d.estado]}>{l.d.estado[0].toUpperCase() + l.d.estado.slice(1)}</dd>
                </div>
              </dl>

              {l.d.atributos.length > 0 && (
                <ul class="atributos">
                  {l.d.atributos.slice(0, 4).map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>
              )}

              {l.d.demo && <p class="nota">Lote de demostración con datos de ejemplo</p>}
              {l.d.coordenadas?.aproximadas && !l.d.demo && <p class="nota">Lindero y ubicación aproximados</p>}

              <div class="ficha-acciones">
                {l.whatsapp && (
                  <a class="btn btn-primary" href={l.whatsapp} target="_blank" rel="noopener">
                    <Icon name="whatsapp" />
                    Agendar visita
                  </a>
                )}
                <div class="fila">
                  {l.video && (
                    <button class="btn btn-ghost btn-sm" type="button" data-recorrido={l.video.src} data-poster={l.video.poster}>
                      <Icon name="play-fill" />
                      Recorrido
                    </button>
                  )}
                  <a class="btn btn-ghost btn-sm" href={url(`lotes/${l.id}/`)}>
                    Ficha completa
                  </a>
                  {l.ruta && (
                    <a class="btn btn-ghost btn-sm" href={l.ruta} target="_blank" rel="noopener">
                      <Icon name="navigation-arrow" />
                      Cómo llegar
                    </a>
                  )}
                </div>
                <div class="fila">
                  <button class="btn btn-ghost btn-sm" type="button" data-orbitar aria-pressed="false">
                    <Icon name="arrows-clockwise" />
                    <span data-orbitar-txt>Girar alrededor</span>
                  </button>
                  <button class="btn btn-ghost btn-sm" type="button" data-volver>
                    <Icon name="arrow-left" />
                    Volver al mapa
                  </button>
                </div>
              </div>
            </div>
          </article>
        ))
      }
      {
        config.dibujo && (
          <div class="dibujo" data-dibujo data-estado="listo">
            <strong>Lindero (solo en tu computador)</strong>
            <span data-dibujo-info />
            <p class="ayuda">Clic en cada esquina del lote, en orden. Puedes girar y acercar mientras dibujas</p>
            <div class="fila">
              <button class="btn btn-ghost btn-sm" type="button" data-dibujo-accion="iniciar">
                Dibujar lindero
              </button>
              <button class="btn btn-primary btn-sm solo-dibujo" type="button" data-dibujo-accion="guardar">
                Guardar
              </button>
              <button class="btn btn-ghost btn-sm solo-dibujo" type="button" data-dibujo-accion="deshacer">
                Deshacer
              </button>
              <button class="btn btn-ghost btn-sm solo-dibujo" type="button" data-dibujo-accion="borrar">
                Borrar
              </button>
              <button class="btn btn-ghost btn-sm solo-dibujo" type="button" data-dibujo-accion="cancelar">
                Cancelar
              </button>
            </div>
          </div>
        )
      }
    </aside>

    <dialog class="video" data-video aria-label="Recorrido del lote">
      <button class="icon-btn" type="button" data-video-cerrar aria-label="Cerrar el recorrido"><Icon name="x" /></button>
      <video controls playsinline preload="none" data-video-el></video>
    </dialog>
  </div>

  <script type="application/json" id="globo-config" set:html={configJson} />
</Base>

<script>
  import { iniciarGlobo } from '../lib/globo';
  iniciarGlobo();
</script>

<style>
  /* Capas propias de la página: globo 0, degradado 1, lista y ficha 20, llegada 25 (nav global 30) */
  :global(body:has([data-globo])) {
    overflow: hidden;
  }
  :global(body:has([data-globo]) .site-footer) {
    display: none;
  }
  .globo {
    position: fixed;
    inset: 0;
    background: var(--bg);
  }
  .lienzo {
    position: absolute;
    inset: 0;
  }
  .lienzo :global(gmp-map-3d) {
    width: 100%;
    height: 100%;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Llegada: texto abajo a la izquierda, el planeta gira detrás. Se deja libre la franja de atribución de Google */
  .llegada {
    position: absolute;
    left: var(--gutter);
    bottom: 96px;
    z-index: 25;
    max-width: 720px;
    display: grid;
    gap: 18px;
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease), visibility 0.6s;
  }
  .llegada h1 {
    font-size: clamp(2.1rem, 4.2vw, 3.35rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
    padding-bottom: 2px;
  }
  .llegada h1 span {
    display: block;
    color: rgb(244 245 243 / 0.55);
  }
  .llegada > p {
    font-size: 1.125rem;
    color: rgb(244 245 243 / 0.8);
    max-width: 44ch;
  }
  .llegada .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .llegada [hidden],
  .fondo[hidden] {
    display: none;
  }
  .fondo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .llegada .respaldo-aviso {
    font-size: 0.9375rem;
    color: var(--muted);
  }
  [data-vista]:not([data-vista='llegada']) .llegada {
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px);
    pointer-events: none;
  }
  .globo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(11 12 13 / 0.72) 0%, rgb(11 12 13 / 0) 58%);
    transition: opacity 0.8s var(--ease);
  }
  [data-vista]:not([data-vista='llegada'])::before {
    opacity: 0;
  }
  /* Velo superior: la marca y el menú se leen sobre cualquier imagen */
  .globo::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 120px;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(11 12 13 / 0.6) 0%, rgb(11 12 13 / 0) 100%);
  }

  /* Títulos del vuelo al lote: centrados abajo, como en el video; la lista y la ficha esperan a que termine */
  .etapa {
    position: absolute;
    left: 50%;
    bottom: 104px;
    z-index: 22;
    display: grid;
    justify-items: center;
    gap: 6px;
    width: min(92vw, 820px);
    text-align: center;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 10px);
    transition: opacity 0.5s var(--ease), transform 0.6s var(--ease);
    text-shadow: 0 2px 28px rgb(0 0 0 / 0.55);
  }
  .etapa.visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .etapa strong {
    font-size: clamp(2rem, 4.4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .etapa span {
    font-size: clamp(0.9375rem, 1.4vw, 1.125rem);
    color: rgb(244 245 243 / 0.75);
  }
  [data-cine] .rail,
  [data-cine] .ficha {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Botones en píldora sobre el globo: Omitir (durante el vuelo) y Lista (tablet, con la ficha abierta) */
  .pildora {
    position: absolute;
    z-index: 26;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(17 19 20 / 0.84);
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 12px 32px rgb(0 0 0 / 0.35);
    color: var(--text);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease), visibility 0.4s, background 0.2s;
  }
  .pildora:hover {
    background: rgb(36 38 40 / 0.92);
  }
  .pildora:active {
    transform: translateY(1px);
  }
  .pildora:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .omitir {
    left: 50%;
    bottom: 52px;
    translate: -50% 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  [data-cine] .omitir {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .lista-btn {
    display: none;
  }
  @media (prefers-reduced-transparency: reduce) {
    .pildora {
      background: var(--bg-2);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  /* Superficie flotante compartida por la lista y la ficha */
  .rail,
  .ficha {
    position: absolute;
    z-index: 20;
    top: calc(var(--nav-h) + 8px);
    background: rgb(17 19 20 / 0.84);
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 24px 60px rgb(0 0 0 / 0.35);
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease), visibility 0.5s;
  }
  @media (prefers-reduced-transparency: reduce) {
    .rail,
    .ficha {
      background: var(--bg-2);
      backdrop-filter: none;
