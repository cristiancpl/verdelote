---
import 'maplibre-gl/dist/maplibre-gl.css';
import marca from '../assets/marca/am-marca-claro.png';
import { destinos, area, perimetro, miles } from '../data/destinos';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const titulo = 'Del espacio al lote · AM Grupo Inmobiliario';
const descripcion = 'Elige un lote y baja hasta él desde el espacio. Lo ves desde el aire, con su lindero y sus medidas, antes de ir';
const imagen = new URL(`${base}/og-default.png`, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#05070a" />
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <title>{titulo}</title>
  </head>
  <body data-etapa="espacio" data-video="no">
    <!-- Resplandor alrededor del planeta; el recorrido lo mantiene centrado en el globo -->
    <div id="halo" aria-hidden="true"></div>
    <div id="mapa" aria-hidden="true"></div>

    <video id="dron" muted playsinline preload="metadata"></video>

    <header class="barra">
      <img src={marca.src} width="88" height="43" alt="AM Grupo Inmobiliario" />
      <button type="button" class="enlace" data-accion="acerca">Cómo se hace</button>
    </header>

    <!-- Relato del descenso -->
    <div class="hud" aria-hidden="true">
      <strong id="hud-lugar">Planeta Tierra</strong>
      <span>Altitud <b id="hud-altitud"></b></span>
    </div>
    <button type="button" class="saltar secundario" data-accion="saltar">Saltar el vuelo</button>

    <!-- Planeta: elegir lote -->
    <section class="panel portada" data-panel="espacio">
      <p class="sobre">Recorrido desde el espacio</p>
      <h1>De todo el planeta, este lugar</h1>
      <p class="bajada">Elige un lote y baja hasta él. Lo ves desde el aire, con su lindero y sus medidas, antes de ir</p>
      <ul class="destinos">
        {destinos.map((d) => (
          <li>
            <button type="button" data-elegir={d.id} aria-pressed="false">
              <span class="punto"></span>
              <span class="textos"><strong>{d.nombre}</strong><span>{d.lugar}</span></span>
              <em>{d.estado === 'completo' ? 'Con toma de dron' : 'Solo satélite'}</em>
            </button>
          </li>
        ))}
      </ul>
      <button type="button" class="principal" data-accion="bajar">Bajar al lote</button>
    </section>

    {destinos.filter((d) => d.video).map((d) => (
      <>
        <section class="panel" data-panel="lote" data-de={d.id}>
          <p class="sobre">{d.lugar} · lote de demostración</p>
          <h2>{d.nombre}</h2>
          <ul class="cifras">
            {d.cifras.map((c) => <li><strong>{c.valor}</strong><span>{c.etiqueta}</span></li>)}
          </ul>
          {d.cercanias && <p class="cercanias">{d.cercanias.join(' · ')}</p>}
          <div class="acciones">
            <button type="button" class="principal" data-accion="lindero">Ver lindero y medidas</button>
            <button type="button" class="secundario" data-accion="compartir">Compartir</button>
          </div>
          <div class="enlaces">
            <button type="button" class="enlace" data-accion="repetir">Repetir el video</button>
            <button type="button" class="enlace" data-accion="planeta">Volver al planeta</button>
          </div>
          <p class="credito">Video: {d.video!.credito}. Es un lugar real, no un lote en venta</p>
        </section>

        {d.lindero && (
          <section class="panel tarjeta" data-panel="lindero" data-de={d.id}>
            <p class="sobre">Lindero y medidas</p>
            <h2>{d.nombre}</h2>
            <ul class="cifras">
              <li><strong>{miles(d.areaOficial ?? Math.round(area(d.lindero) / 50) * 50)} m²</strong><span>{d.areaOficial ? 'Área catastral' : 'Área'}</span></li>
              <li><strong>{miles(Math.round(perimetro(d.lindero)))} m</strong><span>Perímetro</span></li>
              <li><strong>{d.lindero.length}</strong><span>Lados medidos</span></li>
            </ul>
            <p class="nota">{d.linderoFuente ? `Lindero oficial: ${d.linderoFuente}` : 'Lindero ilustrativo, trazado sobre la imagen aérea'}. En un lote propio se dibuja con el plano o el levantamiento topográfico</p>
            <div class="acciones">
              <button type="button" class="principal" data-accion="video">Volver al video</button>
              <button type="button" class="secundario" data-accion="planeta">Volver al planeta</button>
            </div>
          </section>
        )}
      </>
    ))}

    {/* Lotes que todavía no tienen vuelo de dron */}
    {destinos.filter((d) => !d.video).map((d) => (
      <section class="panel tarjeta" data-panel="satelite" data-de={d.id}>
        <p class="sobre">{d.lugar} · ubicación aproximada</p>
        <h2>{d.nombre}</h2>
        <ul class="cifras">
          {d.cifras.map((c) => <li><strong>{c.valor}</strong><span>{c.etiqueta}</span></li>)}
        </ul>
        <div class="aviso">
          <strong>Aquí entra la toma de dron</strong>
          <p>Hoy este recorrido llega hasta la imagen satelital. Con un vuelo de dron sobre el lote termina en video, con el lindero y las medidas, como en la demostración</p>
        </div>
        <div class="acciones">
          <button type="button" class="principal" data-accion="demo">Ver la demostración</button>
          <button type="button" class="secundario" data-accion="planeta">Volver al planeta</button>
        </div>
      </section>
    ))}

    <dialog id="acerca">
      <form method="dialog"><button class="cerrar" aria-label="Cerrar">×</button></form>
      <p class="sobre">Sobre esta demostración</p>
      <h2>Cómo se hace</h2>
      <ol>
        <li><strong>El planeta es en vivo</strong>Es un globo con imagen satelital que se puede girar y acercar, no un video grabado</li>
        <li><strong>La llegada es al sitio real</strong>El globo baja hasta el mismo terreno que grabó el dron, con el mismo ángulo</li>
        <li><strong>El final es una toma de dron</strong>El mapa se coloca en el punto de vista exacto del dron y el video entra pegado al terreno, sin corte</li>
        <li><strong>El lindero está medido</strong>Al terminar el video se ve el lote desde arriba, con área, perímetro y el largo de cada lado</li>
      </ol>
      <h3>Qué hace falta para un lote propio</h3>
      <ul>
        <li>Un vuelo de dron sobre el lote: una pasada desde arriba y dos o tres tomas bajando hacia él</li>
        <li>El lindero: plano, levantamiento o archivo de la aplicación de medición</li>
        <li>Los datos de la ficha: área, precio, servicios y cercanías</li>
      </ul>
    </dialog>

    <script>
      import '../scripts/recorrido';
    </script>
  </body>
</html>

<style is:global>
  /*
    Móvil primero: los estilos base son los del celular en vertical, donde el planeta ocupa la parte
    alta de la pantalla y el texto queda compacto abajo. La disposición ancha (texto a la izquierda,
    planeta a la derecha) se agrega al final con una sola consulta de medios. El recorrido usa la
    misma condición para ubicar el globo: si cambia aquí, cambia también en recorrido.ts (ANCHA).
  */
  :root {
    --oro: #f3d48a; --tinta: #f2f4f1; --tenue: #c9d2cb;
    --borde: 18px;
    --arriba: calc(14px + env(safe-area-inset-top, 0px));
    --abajo: calc(18px + env(safe-area-inset-bottom, 0px));
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0; overflow: hidden; overscroll-behavior: none; -webkit-text-size-adjust: 100%;
    color: var(--tinta); font-family: -apple-system, "SF Pro Display", Inter, system-ui, sans-serif;
    background:
      radial-gradient(1px 1px at 12% 22%, #fff9, transparent 60%),
      radial-gradient(1px 1px at 38% 71%, #fff7, transparent 60%),
      radial-gradient(1.5px 1.5px at 67% 14%, #fffa, transparent 60%),
      radial-gradient(1px 1px at 83% 58%, #fff6, transparent 60%),
      radial-gradient(1px 1px at 54% 43%, #fff5, transparent 60%),
      radial-gradient(1.5px 1.5px at 24% 88%, #fff8, transparent 60%),
      #05070a;
    background-size: 420px 420px, 360px 360px, 510px 510px, 300px 300px, 460px 460px, 390px 390px, auto;
  }
  p, h1, h2, h3, ul, ol { margin: 0; padding: 0; }
  ul, ol { list-style: none; }

  /* --- Capas de imagen --- */
  #halo, #mapa, #dron { position: fixed; inset: 0; width: 100%; height: 100%; }
  #mapa, #dron { will-change: transform, filter, opacity; }
  #mapa .maplibregl-canvas { outline: none; }
  body:is([data-etapa="vuelo"], [data-etapa="lote"]) #mapa { pointer-events: none; }

  /* Resplandor azul que rodea el globo y lo separa del fondo. --gx, --gy y --gr los pone el recorrido */
  #halo {
    pointer-events: none; opacity: 0; transition: opacity 1.4s ease;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 34%),
      #8dbbff40 0, #6a9fff2e calc(var(--gr, 170px) * 1.05), #4f86ff14 calc(var(--gr, 170px) * 1.28), transparent calc(var(--gr, 170px) * 1.75));
  }
  body[data-etapa="espacio"] #halo { opacity: 1; }

  /* La opacidad, la deformación y el recorte del video los lleva el recorrido cuadro a cuadro:
     mientras la cámara del mapa entra o sale de la toma, el video va pegado al terreno en perspectiva */
  #dron { object-fit: cover; pointer-events: none; opacity: 0; transform-origin: 0 0; --m0: 70%; --m1: 100%; --b: 12%; }
  /* Recorte del video mientras no llena la pantalla: se abre desde el lote hacia afuera (óvalo)
     y los cuatro bordes del cuadro se difuminan para que no se vea un rectángulo sobre el mapa */
  #dron.recortado {
    --recorte:
      radial-gradient(ellipse 71% 71% at 50% 52%, #000 var(--m0), transparent var(--m1)),
      linear-gradient(to right, transparent 0, #000 var(--b), #000 calc(100% - var(--b)), transparent 100%),
      linear-gradient(to bottom, transparent 0, #000 var(--b), #000 calc(100% - var(--b)), transparent 100%);
    -webkit-mask-image: var(--recorte); mask-image: var(--recorte);
    -webkit-mask-composite: source-in; mask-composite: intersect;
  }
  body[data-video="no"] #dron, body[data-video="si"] #mapa { visibility: hidden; }

  /* Viñeta y degradado para leer el texto sobre la imagen */
  body::after {
    content: ""; position: fixed; inset: 0; z-index: 1; pointer-events: none;
    background: radial-gradient(ellipse at 50% 45%, transparent 55%, #0006 100%);
  }
  body::before {
    content: ""; position: fixed; inset: 0; z-index: 1; pointer-events: none; opacity: 0; transition: opacity 1.4s ease;
    background: linear-gradient(to top, #000d 0%, #0008 34%, transparent 66%);
  }
  body[data-etapa="lote"]::before { opacity: 1; transition-delay: .2s; }

  /* --- Marcadores sobre el mapa --- */
  .pin {
    width: 14px; height: 14px; padding: 0; border: 2px solid #05070a; border-radius: 50%; background: var(--oro);
    box-shadow: 0 0 0 4px #f3d48a40; cursor: pointer; transition: background .2s;
  }
  .pin::before { content: ""; position: absolute; inset: -15px; border-radius: 50%; } /* zona de toque de 44 px */
  .pin:hover { background: #fff; }
  .pin span {
    position: absolute; left: 22px; top: 50%; translate: 0 -50%; white-space: nowrap; font-size: .76rem; font-weight: 600;
    color: var(--tinta); text-shadow: 0 1px 10px #000, 0 0 3px #000; opacity: 0; transition: opacity .3s;
  }
  .pin.elegido span, .pin:hover span { opacity: 1; }
  .pin.elegido::after, .zona::after {
    content: ""; position: absolute; inset: -6px; border-radius: 50%; border: 2px solid var(--oro); animation: pulso 2.2s ease-out infinite;
  }
  @keyframes pulso { from { transform: scale(.6); opacity: 1; } to { transform: scale(2.6); opacity: 0; } }
  body:not([data-etapa="espacio"]) .pin { visibility: hidden; }

  .zona { width: 84px; height: 84px; border-radius: 50%; border: 2px solid var(--oro); background: #f3d48a1f; pointer-events: none; visibility: hidden; }
  .zona::after { inset: 0; }
  body[data-etapa="satelite"] .zona { visibility: visible; }

  .medida { pointer-events: none; }
  .medida i {
    display: block; padding: 3px 8px; border-radius: 999px; background: #0b0f0cd9; color: var(--oro); font-style: normal; font-size: .72rem;
    font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; opacity: 0; transition: opacity .3s ease;
  }
  /* Las medidas aparecen cuando la cámara ya está llegando a la vista desde arriba */
  body[data-etapa="lindero"] .medida i { opacity: 1; transition: opacity .6s ease 1.5s; }

  /* --- Barra superior --- */
  .barra {
    position: fixed; z-index: 3; left: var(--borde); right: var(--borde); top: var(--arriba);
    display: flex; align-items: center; justify-content: space-between; pointer-events: none;
  }
  .barra > * { pointer-events: auto; }
  .barra img { display: block; width: 56px; height: auto; filter: drop-shadow(0 1px 8px #0008); }
  body[data-etapa="vuelo"] .barra .enlace { opacity: 0; pointer-events: none; }

  /* --- Relato del descenso --- */
  .hud {
    position: fixed; z-index: 3; left: 50%; top: calc(var(--arriba) + 46px); translate: -50% 0; width: max-content; max-width: 90vw; text-align: center;
    opacity: 0; transition: opacity .6s ease; pointer-events: none; text-shadow: 0 1px 14px #000b;
  }
  body[data-etapa="vuelo"] .hud { opacity: 1; }
  .hud strong { display: block; font-size: 1.15rem; font-weight: 600; letter-spacing: -.02em; }
  .hud span { display: block; margin-top: 3px; font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; color: var(--tenue); }
  .hud b { font-weight: 600; color: var(--oro); font-variant-numeric: tabular-nums; }
  .saltar { position: fixed; z-index: 3; right: var(--borde); bottom: var(--abajo); opacity: 0; pointer-events: none; }
  body[data-etapa="vuelo"] .saltar { opacity: 1; pointer-events: auto; transition: opacity .6s ease 1.2s; }
  /* Durante la entrada al video no se muestra el relato del vuelo */
  body.zambullida .hud, body.zambullida .saltar { opacity: 0; pointer-events: none; transition: opacity .4s ease; }

  /* --- Paneles --- */
  .panel {
    position: fixed; z-index: 3; left: var(--borde); right: var(--borde); bottom: var(--abajo);
    opacity: 0; transform: translateY(14px); pointer-events: none; transition: opacity .6s ease, transform .6s ease;
  }
  .panel.visible { opacity: 1; transform: none; pointer-events: auto; transition-delay: .5s; }
  .panel[data-panel="lote"].visible { transition-delay: .3s; }
  .panel[data-panel="lindero"].visible { transition-delay: 1.1s; }
  .tarjeta {
    padding: 18px 18px 16px; border-radius: 20px; background: #0b0f0cc7; border: 1px solid #ffffff1f;
    backdrop-filter: blur(22px) saturate(1.3);
  }

  .sobre { margin-bottom: 7px; font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; color: var(--oro); }
  h1, h2 { font-weight: 600; letter-spacing: -.03em; line-height: 1.1; text-shadow: 0 2px 24px #0009; }
  h1 { font-size: clamp(1.35rem, 6.2vw, 1.65rem); text-wrap: balance; }
  h2 { font-size: 1.35rem; }
  .tarjeta h2 { font-size: 1.25rem; text-shadow: none; }
  .bajada { margin: 7px 0 13px; max-width: 30em; font-size: .84rem; line-height: 1.45; color: var(--tenue); }

  .destinos { display: grid; gap: 6px; margin: 12px 0; }
  .destinos button {
    display: flex; align-items: center; gap: 10px; width: 100%; min-height: 44px; padding: 6px 12px; text-align: left; color: var(--tinta);
    background: #ffffff14; border: 1px solid transparent; border-radius: 12px; backdrop-filter: blur(14px);
  }
  .destinos button:hover { background: #ffffff1f; transform: none; }
  .destinos button[aria-pressed="true"] { background: #f3d48a1f; border-color: #f3d48a8c; }
  .destinos .punto { flex: none; width: 9px; height: 9px; border-radius: 50%; border: 2px solid var(--tenue); }
  .destinos button[aria-pressed="true"] .punto { background: var(--oro); border-color: var(--oro); }
  .destinos .textos { flex: 1; min-width: 0; display: grid; }
  .destinos strong { font-size: .86rem; font-weight: 600; line-height: 1.2; }
  .destinos .textos span { font-size: .7rem; font-weight: 400; line-height: 1.3; color: var(--tenue); }
  .destinos em { flex: none; font-style: normal; font-size: .62rem; font-weight: 500; color: var(--tenue); }
  .destinos button[aria-pressed="true"] em { color: var(--oro); }
  .portada .principal { width: 100%; }

  .cifras { display: flex; flex-wrap: wrap; gap: 8px 22px; margin: 12px 0; }
  .cifras strong { display: block; font-size: 1.02rem; font-weight: 600; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .cifras span { font-size: .68rem; color: var(--tenue); }
  .cercanias { margin: -2px 0 14px; font-size: .76rem; color: var(--tenue); }
  .nota { margin-bottom: 14px; font-size: .78rem; line-height: 1.45; color: var(--tenue); }
  .aviso { margin-bottom: 14px; padding: 11px 13px; border-radius: 12px; background: #f3d48a1a; border: 1px solid #f3d48a55; }
  .aviso strong { display: block; margin-bottom: 3px; font-size: .84rem; color: var(--oro); }
  .aviso p { font-size: .78rem; line-height: 1.45; color: var(--tinta); }
  .acciones { display: flex; flex-wrap: wrap; gap: 8px; }
  .acciones .principal { flex: 1 1 auto; }
  .enlaces { display: flex; gap: 18px; margin-top: 11px; }
  .credito { margin-top: 10px; font-size: .62rem; line-height: 1.45; color: #ffffff8c; }

  /* --- Botones --- */
  button { font: inherit; font-weight: 600; border: 0; cursor: pointer; -webkit-tap-highlight-color: transparent; transition: transform .2s, background .2s, opacity .3s; }
  button:focus-visible { outline: 2px solid var(--oro); outline-offset: 3px; }
  .principal, .secundario { min-height: 44px; font-size: .88rem; border-radius: 999px; padding: 11px 18px; }
  .principal { color: #0b0f0c; background: var(--tinta); }
  .principal:hover { transform: translateY(-1px); background: #fff; }
  .secundario { color: var(--tinta); background: #ffffff24; backdrop-filter: blur(12px); }
  .secundario:hover { background: #ffffff3a; }
  .enlace { padding: 6px 0; font-size: .78rem; font-weight: 500; color: var(--tinta); background: none; text-decoration: underline; text-decoration-color: #ffffff66; text-underline-offset: 4px; text-shadow: 0 1px 10px #000a; }
  .enlace:hover { text-decoration-color: var(--oro); }
  body[data-sin-mapa] [data-accion="lindero"] { display: none; }

  /* --- Cómo se hace --- */
  dialog {
    width: min(560px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); padding: 24px 20px 20px; color: var(--tinta);
    background: #0d120ef2; border: 1px solid #ffffff24; border-radius: 22px; backdrop-filter: blur(24px);
  }
  dialog::backdrop { background: #000a; }
  dialog h2 { font-size: 1.4rem; text-shadow: none; margin-bottom: 16px; }
  dialog h3 { margin: 20px 0 10px; font-size: .95rem; font-weight: 600; }
  dialog ol { display: grid; gap: 12px; counter-reset: paso; }
  dialog ol li { position: relative; padding-left: 36px; font-size: .84rem; line-height: 1.5; color: var(--tenue); counter-increment: paso; }
  dialog ol li::before {
    content: counter(paso); position: absolute; left: 0; top: 1px; width: 24px; height: 24px; display: grid; place-items: center;
    border-radius: 50%; background: #f3d48a26; color: var(--oro); font-size: .76rem; font-weight: 600;
  }
  dialog ol strong { display: block; color: var(--tinta); font-weight: 600; }
  dialog ul { display: grid; gap: 8px; }
  dialog ul li { padding-left: 18px; position: relative; font-size: .84rem; line-height: 1.5; color: var(--tenue); }
  dialog ul li::before { content: ""; position: absolute; left: 2px; top: .62em; width: 6px; height: 6px; border-radius: 50%; background: var(--oro); }
  .cerrar { position: absolute; right: 12px; top: 12px; width: 36px; height: 36px; border-radius: 50%; font-size: 1.4rem; line-height: 1; color: var(--tinta); background: #ffffff1a; }
  .cerrar:hover { background: #ffffff33; }

  /* Celulares bajitos: el planeta manda, así que el texto de apoyo se retira */
  @media (max-height: 700px) {
    .bajada { display: none; }
    .destinos { margin-top: 10px; }
  }
  @media (max-height: 590px) {
    .portada .sobre { display: none; }
    /* Los lotes pasan a una fila que se desliza con el dedo */
    .destinos { grid-auto-flow: column; grid-auto-columns: 74%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .destinos::-webkit-scrollbar { display: none; }
    .destinos li { scroll-snap-align: start; }
  }

  /* --- Disposición ancha: computador, tableta y celular acostado --- */
  @media (min-width: 821px), (min-width: 560px) and (min-aspect-ratio: 4/3) {
    :root { --borde: clamp(22px, 4vw, 48px); --arriba: clamp(14px, 4vh, 36px); --abajo: clamp(16px, 6vh, 64px); }
    .barra img { width: clamp(58px, 6vw, 76px); }
    .hud { top: var(--arriba); }
    .hud strong { font-size: clamp(1.2rem, 2.2vw, 1.7rem); }
    .hud span { margin-top: 4px; font-size: .72rem; }
    .pin span { font-size: .8rem; }
    .zona { width: 96px; height: 96px; }
    .medida i { padding: 4px 9px; font-size: .78rem; }

    .panel { right: auto; width: min(540px, 46vw); }
