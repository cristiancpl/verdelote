---
import { getImage, Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Icon, { type IconName } from '../../components/Icon.astro';
import PauseButton from '../../components/PauseButton.astro';
import Base from '../../layouts/Base.astro';
import { absoluteUrl, formatArea, formatPrecio, formatPrecioM2, formatTelefono, nombreCorto, url } from '../../lib/format';
import { primerClip } from '../../lib/lote';

export async function getStaticPaths() {
  const lotes = await getCollection('lotes');
  return lotes.map((lote) => ({ params: { id: lote.id }, props: { lote } }));
}

interface Props {
  lote: CollectionEntry<'lotes'>;
}

const { lote } = Astro.props;
const d = lote.data;
const lugar = [d.vereda, d.municipio, d.departamento].filter(Boolean).join(', ');
const kicker = `${d.vereda ? `${d.vereda} · ` : ''}${d.municipio}, ${d.departamento}`;
const whatsappUrl = d.contacto
  ? `https://wa.me/${d.contacto.whatsapp}?text=${encodeURIComponent(
      `Hola ${d.contacto.nombre}, vi el ${d.nombre} en Verdelote y quiero agendar una visita`,
    )}`
  : undefined;

// Portada: video de un capítulo (o del recorrido) si existe; si no, la foto de portada; si no, un fondo sobrio
const clip = primerClip(d);
const heroPoster = clip ? (await getImage({ src: clip.poster, width: 1920, format: 'webp' })).src : undefined;

// Reproductor a pantalla completa: recorrido completo y vuelo comparten el mismo diálogo
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const videos: Record<string, { src: string; poster: string; label: string }> = {};
if (d.video_completo) {
  videos.completo = {
    src: url(d.video_completo.src),
    poster: (await getImage({ src: d.video_completo.poster, width: 1600, format: 'webp' })).src,
    label: 'Recorrido completo',
  };
}
if (d.vuelo) {
  videos.vuelo = {
    src: url(d.vuelo.src),
    poster: (await getImage({ src: d.vuelo.poster, width: 1600, format: 'webp' })).src,
    label: 'Vuelo hasta el lote',
  };
}
const playKey = d.video_completo ? 'completo' : d.vuelo ? 'vuelo' : undefined;
const playTitulo = d.video_completo ? 'Ver el recorrido completo' : 'Ver el vuelo hasta el lote';
const playDetalle = d.video_completo
  ? `Desde el espacio hasta el lote · ${d.video_completo.duracion}`
  : d.vuelo
    ? `Del planeta al lote · ${mmss(d.vuelo.duracion_s)}`
    : '';

// Recorrido por scroll
const historiaPosters = await Promise.all(
  d.historia.map(async (h) => (h.video ? (await getImage({ src: h.media, width: 1920, format: 'webp' })).src : undefined)),
);

const cifras = d.cifras ?? [
  { valor: formatArea(d.area_m2), etiqueta: 'Área total' },
  ...(d.explanacion_m2 ? [{ valor: formatArea(d.explanacion_m2), etiqueta: 'Explanados' }] : []),
  { valor: formatPrecio(d.precio_cop), etiqueta: d.estado === 'disponible' ? 'Precio' : `Precio · ${d.estado}` },
];

const iconoAtributo = (texto: string): IconName => {
  const t = texto.toLowerCase();
  if (t.includes('escritur')) return 'scroll';
  if (t.includes('explanaci')) return 'square-half-bottom';
  if (t.includes('riego')) return 'plant';
  if (t.includes('acueducto') || t.includes('agua')) return 'drop';
  if (t.includes('carretera') || t.includes('vía') || t.includes('autopista')) return 'road-horizon';
  if (t.includes('valoriz')) return 'trend-up';
  return 'check-circle';
};

// Mosaico: los atributos van en filas de hasta tres (la última fila se reparte sin dejar huecos)
const atributos = d.atributos.map((texto) => ({ texto, icono: iconoAtributo(texto) }));
const spanDe = (resto: number) => (resto >= 3 ? 2 : resto === 2 ? 3 : 6);
const celdas = atributos.map((a, i) => ({
  ...a,
  span: spanDe(Math.min(3, atributos.length - Math.floor(i / 3) * 3)),
  ultimoImpar: i === atributos.length - 1 && atributos.length % 2 === 1,
}));

// Cercanías agrupadas por minutos, de la más cercana a la más lejana
const minusculaInicial = (t: string) => t.charAt(0).toLowerCase() + t.slice(1);
const grupos = [...Map.groupBy(d.cercanias, (c) => c.minutos ?? 0)]
  .sort(([a], [b]) => a - b)
  .map(([minutos, items]) => ({
    minutos,
    lugares: items.map((i, n) => (n === 0 ? i.lugar : minusculaInicial(i.lugar))).join(', '),
  }));

// Foto del mosaico: la indicada en foto_mosaico o la primera de la galería que la historia aún no usa
const usadas = new Set(d.historia.map((h) => h.media.src));
const fotoMosaico =
  d.galeria[d.foto_mosaico ?? -1] ?? d.galeria.find((g) => !usadas.has(g.src.src)) ?? d.galeria[0];

// Ubicación
const ubicacionImg = d.vuelo?.final ?? d.ubicacion?.src;
const aproximada = d.coordenadas?.aproximadas;

// Vista previa al compartir (WhatsApp, redes): portada recortada a 1200x630
const og = d.portada
  ? await getImage({ src: d.portada, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 })
  : undefined;
const descripcion = `${formatArea(d.area_m2)} en ${d.municipio}, ${d.departamento} por ${formatPrecio(d.precio_cop)}. ${d.resumen}`;

const fichaUrl = absoluteUrl(Astro.url.pathname);
const precioM2 = formatPrecioM2(d.precio_cop, d.area_m2);
const rutaUrl = d.coordenadas
  ? `https://www.google.com/maps/dir/?api=1&destination=${d.coordenadas.lat},${d.coordenadas.lon}`
  : undefined;

// Mensaje listo para pegar en WhatsApp (formato *negrita* de WhatsApp): nombre, tres datos clave, precio y enlace
const datosClave = cifras
  .filter((c) => !/^precio/i.test(c.etiqueta))
  .slice(0, 3)
  .map((c) => `- ${c.valor} ${c.etiqueta.charAt(0).toLowerCase()}${c.etiqueta.slice(1)}`);
const mensajeWhatsapp = [
  `*${d.nombre}*`,
  `${d.municipio}, ${d.departamento}`,
  '',
  ...datosClave,
  '',
  `Precio: ${formatPrecio(d.precio_cop)} (${precioM2})`,
  `Recorrido en video y ficha: ${fichaUrl}`,
].join('\n');

// Datos estructurados: oferta del lote con su lugar (y geo si hay coordenadas).
// Los lotes de demostración no se publican como oferta real
const disponibilidad = {
  disponible: 'https://schema.org/InStock',
  reservado: 'https://schema.org/OutOfStock',
  vendido: 'https://schema.org/SoldOut',
}[d.estado];
const lugarLd = {
  '@type': 'Place',
  name: lugar,
  address: {
    '@type': 'PostalAddress',
    ...(d.vereda && { streetAddress: d.vereda }),
    addressLocality: d.municipio,
    addressRegion: d.departamento,
    addressCountry: 'CO',
  },
  ...(d.coordenadas && {
    geo: { '@type': 'GeoCoordinates', latitude: d.coordenadas.lat, longitude: d.coordenadas.lon },
  }),
};
const fichaLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.nombre,
  description: d.resumen,
  category: 'Lote',
  url: fichaUrl,
  ...(og && { image: [absoluteUrl(og.src)] }),
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Área total', value: d.area_m2, unitCode: 'MTK' },
    ...(d.explanacion_m2
      ? [{ '@type': 'PropertyValue', name: 'Área explanada', value: d.explanacion_m2, unitCode: 'MTK' }]
      : []),
  ],
  offers: {
    '@type': 'Offer',
    url: fichaUrl,
    price: d.precio_cop,
    priceCurrency: 'COP',
    availability: disponibilidad,
    availableAtOrFrom: lugarLd,
  },
};
---

<Base
  nav="overlay"
  title={d.nombre}
  description={descripcion}
  image={og ? absoluteUrl(og.src) : undefined}
  imageAlt={d.nombre}
  jsonLd={d.demo ? undefined : fichaLd}
>
  <button
    slot="nav-right"
    type="button"
    class="icon-btn"
    data-share
    data-url={fichaUrl}
    data-title={d.nombre}
    data-text={d.tagline}
    aria-label="Compartir este lote"
  >
    <Icon name="share-network" />
  </button>

  <div class="bar no-print" slot="localbar" data-bar>
    <div class="wrap">
      <a class="back" href={url()} aria-label="Volver a los lotes"><Icon name="caret-left" /><span>Lotes</span></a>
      <span class="name">{d.nombre}</span>
      <div class="right">
        <div class="pricebox">
          <span class="price">{formatPrecio(d.precio_cop)}</span>
          <small>{precioM2}</small>
        </div>
        <button
          type="button"
          class="icon-btn sm"
          data-share
          data-url={fichaUrl}
          data-title={d.nombre}
          data-text={d.tagline}
          aria-label="Compartir este lote"
        >
          <Icon name="share-network" />
        </button>
        {
          whatsappUrl && (
            <a class="btn btn-primary btn-sm cta-top" href={whatsappUrl} target="_blank" rel="noopener">
              <Icon name="whatsapp" />
              Agendar visita
            </a>
          )
        }
      </div>
    </div>
  </div>

  <!-- Portada -->
  <section class="stage hero no-print" id="hero" aria-label="Portada del lote">
    {
      clip && heroPoster ? (
        <video
          id="hero-video"
          src={url(clip.src)}
          poster={heroPoster}
          autoplay
          muted
          loop
          playsinline
          aria-hidden="true"
        />
      ) : d.portada ? (
        <Image class="bg" src={d.portada} alt="" widths={[1000, 1600, 2200]} sizes="100vw" loading="eager" />
      ) : (
        <div class="bg bg-sobrio"></div>
      )
    }
    {
      clip && (
        <div class="ctl">
          <PauseButton videoId="hero-video" />
        </div>
      )
    }
    <div class="stage-ui">
      <div class="wrap">
        <div class="hero-title">
          {d.demo && <span class="demo-tag">Lote de demostración</span>}
          <span class="kicker"><Icon name="map-pin" />{kicker}</span>
          <h1>{nombreCorto(d.nombre)}</h1>
          <p>{d.tagline}</p>
        </div>
        <div class:list={['dock', { solo: !playKey }]}>
          {
            playKey && (
              <button type="button" class="playfull" data-play={playKey}>
                <span class="circ"><Icon name="play-fill" /></span>
                <span>
                  <b>{playTitulo}</b>
                  <small>{playDetalle}</small>
                </span>
              </button>
            )
          }
          <div class="grow"></div>
          <div class="price-dock">
            <strong>{formatPrecio(d.precio_cop)}</strong>
            <span>{precioM2}</span>
          </div>
          {
            (rutaUrl || whatsappUrl) && <div class="sep"></div>
          }
          {
            rutaUrl && (
              <a class="btn btn-glass" href={rutaUrl} target="_blank" rel="noopener">
                <Icon name="navigation-arrow" />
                Cómo llegar
                <span class="sr-only">(abre Google Maps)</span>
              </a>
            )
          }
          {
            whatsappUrl && (
              <a class="btn btn-primary" href={whatsappUrl} target="_blank" rel="noopener">
                <Icon name="whatsapp" />
                Agendar visita
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Frase de apertura -->
  {
    d.frase && (
      <section class="band no-print">
        <div class="wrap">
          <p class="statement reveal">
            {d.frase.principal}{' '}
            {d.frase.atenuada && <em>{d.frase.atenuada}</em>}
          </p>
        </div>
      </section>
    )
  }

  <!-- Recorrido por scroll: escena fija a pantalla completa y un paso por capítulo -->
  {
    d.historia.length > 0 && (
      <section class="story no-print" aria-label="Recorrido por el lote" data-story>
        <div class="story-media" aria-hidden="true">
          {d.historia.map((h, i) =>
            h.video ? (
              <video
                class:list={['layer', { on: i === 0 }]}
                data-m={i}
                src={url(h.video)}
                poster={historiaPosters[i]}
                muted
                loop
                playsinline
                preload="none"
              />
            ) : (
              <Image
                class:list={['layer', { on: i === 0 }]}
                data-m={i}
                src={h.media}
                alt=""
                widths={[1000, 1600, 2200]}
                sizes="100vw"
              />
            ),
          )}
          <div class="dots">
            {d.historia.map((_, i) => <span class:list={{ on: i === 0 }}></span>)}
          </div>
        </div>
        <div class="story-steps wrap">
          {d.historia.map((h, i) => (
            <article class="step" data-s={i}>
              <div class="card-media">
                <Image src={h.media} alt="" widths={[500, 900]} sizes="(max-width: 700px) 100vw, 1px" />
              </div>
              <div class="txt">
                <span class="n">{String(i + 1).padStart(2, '0')} · {h.etiqueta}</span>
                <h3>{h.titulo}</h3>
                <p>{h.texto}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <!-- Cifras y mosaico -->
  <section class="band no-print" aria-labelledby="cifras-titulo">
    <div class="wrap">
      <h2 class="h-lg reveal" id="cifras-titulo">Todo en cifras</h2>
      {!d.frase && <p class="resumen reveal">{d.resumen}</p>}
      <div class="figures reveal" style={`--n:${cifras.length}`}>
        {
          cifras.map((c) => (
            <div class:list={{ price: /^precio/i.test(c.etiqueta) }}>
              <strong class:list={{ long: c.valor.length > 9 }}>{c.valor}</strong>
              <span>{c.etiqueta}</span>
            </div>
          ))
        }
      </div>

      {
        (celdas.length > 0 || grupos.length > 0) && (
          <div class="bento reveal">
            {celdas.map((c) => (
              <div class:list={['tile', `c${c.span}`, { odd: c.ultimoImpar }]}>
                <Icon name={c.icono} />
                <strong>{c.texto}</strong>
              </div>
            ))}
            {grupos.length > 0 && (
              <div class:list={['tile', 'r2', 'near-tile', fotoMosaico ? 'c4' : 'c6']}>
                <div>
                  <strong>Cerca de todo</strong>
                  <small>Tiempos desde el lote</small>
                </div>
                <div class="near">
                  {grupos.map((g) => (
                    <>
                      <b>
                        {g.minutos}
                        <small>min</small>
                      </b>
                      <span>{g.lugares}</span>
                    </>
                  ))}
                </div>
              </div>
            )}
            {fotoMosaico && (
              <div class:list={['tile', 't-photo', 'r2', grupos.length > 0 ? 'c2' : 'c6']}>
                <Image src={fotoMosaico.src} alt={fotoMosaico.alt} widths={[600, 1000]} sizes="(max-width: 700px) 100vw, 440px" />
                <div class="cap">
                  <strong>{fotoMosaico.alt}</strong>
                </div>
              </div>
            )}
          </div>
        )
      }
    </div>
  </section>

  <!-- Ubicación -->
  {
    (d.vuelo || rutaUrl) && (
      <section class="band loc-band no-print" id="ubicacion" aria-label="Ubicación">
        <div class="wrap">
          <div class="loc reveal">
            {ubicacionImg ? (
              <Image
                class="locimg"
                src={ubicacionImg}
                alt={d.vuelo ? 'Vista aérea del lote resaltado en la ladera' : 'Ubicación del lote'}
                widths={[900, 1600, 2200]}
                sizes="(max-width: 1320px) 100vw, 1320px"
              />
            ) : (
              <div class="locimg bg-sobrio"></div>
            )}
            <div class="over">
              <div>
                <h3>{d.vereda ?? d.municipio}</h3>
                <p>
                  {d.municipio}, {d.departamento}
                  {aproximada && ' · ubicación aproximada'}
                </p>
              </div>
              <div class="actions">
                {d.vuelo && (
                  <button type="button" class="btn btn-glass" data-play="vuelo">
                    <Icon name="play-fill" />
                    Ver el vuelo
                  </button>
                )}
                {rutaUrl && (
                  <a class="btn btn-light" href={rutaUrl} target="_blank" rel="noopener">
                    <Icon name="navigation-arrow" />
                    Cómo llegar
                    <span class="sr-only">(abre Google Maps)</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Galería -->
  {
    d.galeria.length > 0 && (
      <section class="gal no-print" aria-labelledby="galeria-titulo">
        <div class="wrap strip-head">
          <h2 class="h-lg" id="galeria-titulo">Galería</h2>
          <div class="arrows">
            <button type="button" class="icon-btn" data-strip-prev aria-label="Fotos anteriores">
              <Icon name="caret-left" />
            </button>
            <button type="button" class="icon-btn" data-strip-next aria-label="Fotos siguientes">
              <Icon name="caret-right" />
            </button>
          </div>
        </div>
        <div class="strip" data-strip>
          {d.galeria.map((g, i) => (
            <button type="button" data-open={i} aria-label={`Ampliar foto ${i + 1} de ${d.galeria.length}: ${g.alt}`}>
              <Image src={g.src} alt="" widths={[560, 1100]} sizes="(max-width: 700px) 80vw, 560px" />
            </button>
          ))}
        </div>

        <dialog class="lightbox" aria-label="Galería de fotos" data-lightbox>
          <button type="button" class="lb-close" data-close aria-label="Cerrar galería">
            <Icon name="x" />
          </button>
          <button type="button" class="lb-nav prev" data-prev aria-label="Foto anterior">
            <Icon name="caret-left" />
          </button>
          {d.galeria.map((g, i) => (
            <figure class="lb-item" data-item={i} hidden>
              <Image src={g.src} alt={g.alt} widths={[900, 1600]} sizes="90vw" loading="lazy" />
              <figcaption>
                {g.alt}
                <span>
                  {i + 1} de {d.galeria.length}
                </span>
              </figcaption>
            </figure>
          ))}
          <button type="button" class="lb-nav next" data-next aria-label="Foto siguiente">
            <Icon name="caret-right" />
          </button>
        </dialog>
      </section>
    )
  }

  <!-- Cierre -->
  <section class="wrap closing no-print" id="visita">
    {
      whatsappUrl && d.contacto ? (
        <>
          <h2 class="reveal">Conócelo en persona</h2>
          <p>{d.contacto.nombre} responde por WhatsApp y te acompaña al lote</p>
          <div class="actions">
            <a class="btn btn-primary" href={whatsappUrl} target="_blank" rel="noopener">
              <Icon name="whatsapp" />
              Agendar visita
            </a>
            {playKey && (
              <button type="button" class="btn btn-light" data-play={playKey}>
                <Icon name="play-fill" />
                Ver el recorrido
              </button>
            )}
          </div>
        </>
      ) : (
        <>
          <h2 class="reveal">Explora más lotes</h2>
          <p>{d.demo ? 'Este es un lote de demostración, con datos de ejemplo' : 'Mira los demás lotes disponibles en Antioquia'}</p>
          <div class="actions">
            <a class="btn btn-primary" href={url('#lotes')}>Ver todos los lotes</a>
          </div>
        </>
      )
    }
  </section>

  <div class="wrap no-print"><div class="agents">
    <span>Para agentes</span>
    {
      d.video_vertical && (
        <a class="btn btn-ghost btn-sm" href={url(d.video_vertical)} download>
          <Icon name="download-simple" />
          Video vertical para redes
        </a>
      )
    }
    <button type="button" class="btn btn-ghost btn-sm" data-copy={mensajeWhatsapp} data-copied="Mensaje copiado">
      <Icon name="copy-simple" />
      Copiar mensaje para WhatsApp
    </button>
    <button type="button" class="btn btn-ghost btn-sm" data-print>
      <Icon name="file-pdf" />
      Descargar ficha (PDF)
    </button>
  </div></div>

  <!-- Ficha para imprimir: siempre en claro y sin elementos de pantalla -->
  <section class="print-only sheet">
    {d.demo && <p class="p-demo">Lote de demostración, con datos de ejemplo</p>}
    <h1>{d.nombre}</h1>
    <p class="p-tag">{d.tagline}</p>
    <p class="p-where">
      {lugar}
      {aproximada && ' · ubicación aproximada'}
    </p>
    {
      d.portada && (
        <div class="print-cover">
          <Image src={d.portada} alt={d.nombre} widths={[900, 1400]} sizes="720px" loading="lazy" />
        </div>
      )
    }
    <div class="p-figures">
      {
        cifras.map((c) => (
          <div>
            <strong>{c.valor}</strong>
            <span>{c.etiqueta}</span>
          </div>
        ))
      }
    </div>
    <p class="p-lead">{d.resumen}</p>
    {
      atributos.length > 0 && (
        <div class="p-block">
          <h2>Lo que incluye</h2>
          <div class="p-inc">
            {atributos.map((a) => (
              <div>
                <Icon name={a.icono} />
                <strong>{a.texto}</strong>
              </div>
            ))}
          </div>
        </div>
      )
    }
    {
      grupos.length > 0 && (
        <div class="p-block">
          <h2>Cerca de todo</h2>
          <div class="p-near">
            {grupos.map((g) => (
              <div class:list={{ wide: g.lugares.length > 36 }}>
                <span class="p-min">
                  {g.minutos}
                  <small>min</small>
                </span>
                <span>{g.lugares}</span>
              </div>
            ))}
          </div>
        </div>
      )
    }
    <div class="p-contact">
      <h2>Contacto</h2>
      {d.contacto && <p>{d.contacto.nombre}, WhatsApp {formatTelefono(d.contacto.whatsapp)}</p>}
      <p>Ficha en línea: {fichaUrl}</p>
    </div>
  </section>

  {
    whatsappUrl && (
      <div class="bottombar no-print">
        <div class="bb-price">
          <strong>{formatPrecio(d.precio_cop)}</strong>
          <span>{precioM2}</span>
        </div>
        <a class="btn btn-primary" href={whatsappUrl} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          Agendar visita
        </a>
      </div>
    )
  }

  <!-- Reproductor a pantalla completa: recorrido completo o vuelo -->
  {
    Object.keys(videos).length > 0 && (
      <dialog class="player no-print" aria-label="Recorrido" data-player data-videos={JSON.stringify(videos)}>
        <video controls playsinline preload="none" data-pv></video>
        <button type="button" class="icon-btn x" data-pclose aria-label="Cerrar reproductor" autofocus>
          <Icon name="x" />
        </button>
      </dialog>
    )
  }
</Base>

<script>
  import { initPrint, initShare } from '../../lib/share';
  import { initPauseButtons, playWhenVisible } from '../../lib/video-controls';

  initPauseButtons();
  initShare();
  initPrint();
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Portada: el video solo corre mientras se ve
  const hero = document.getElementById('hero')!;
  const hv = document.getElementById('hero-video') as HTMLVideoElement | null;
  if (hv) playWhenVisible(hv, hero, 0.2);

  // Al bajar de la portada: la barra fija reemplaza a la navegación transparente
  const root = document.documentElement;
  new IntersectionObserver(([e]) => root.toggleAttribute('data-bar', !e.isIntersecting), {
    rootMargin: '-64px 0px 0px 0px',
  }).observe(hero);

  // Aparición suave de los bloques
  const revelar = new IntersectionObserver(
    (es) =>
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('in');
        revelar.unobserve(e.target);
      }),
    { threshold: 0.2 },
  );
  document.querySelectorAll('.reveal').forEach((el) => revelar.observe(el));

  // Recorrido por scroll: el paso visible activa su capa; el video solo corre cuando su capítulo está activo
  const story = document.querySelector<HTMLElement>('[data-story]');
  if (story) {
    const capas = [...story.querySelectorAll<HTMLElement>('[data-m]')];
    const puntos = [...story.querySelectorAll<HTMLElement>('.dots span')];
    const apilado = window.matchMedia('(max-width: 700px)');
    let activo = 0;
    const sincronizar = (visible = true) => {
      capas.forEach((c, n) => {
        c.classList.toggle('on', n === activo);
        const v = c instanceof HTMLVideoElement ? c : undefined;
        if (!v) return;
        if (n === activo && visible && !reduce && !apilado.matches) v.play().catch(() => undefined);
        else v.pause();
      });
      puntos.forEach((p, n) => p.classList.toggle('on', n === activo));
    };
    const pasos = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          activo = Number((e.target as HTMLElement).dataset.s);
          sincronizar();
        }),
      { threshold: 0.55 },
    );
    story.querySelectorAll('.step').forEach((s) => pasos.observe(s));
    new IntersectionObserver(([e]) => sincronizar(e.isIntersecting), { threshold: 0 }).observe(story);
  }

  // Reproductor a pantalla completa (recorrido completo y vuelo): Esc o el botón lo cierran y pausan
  const player = document.querySelector<HTMLDialogElement>('[data-player]');
  if (player) {
    const pv = player.querySelector<HTMLVideoElement>('[data-pv]')!;
    const fuentes = JSON.parse(player.dataset.videos ?? '{}') as Record<string, { src: string; poster: string; label: string }>;
    let actual = '';
    document.querySelectorAll<HTMLElement>('[data-play]').forEach((b) =>
      b.addEventListener('click', () => {
        const clave = b.dataset.play ?? '';
        const f = fuentes[clave];
        if (!f) return;
        if (actual !== clave) {
          pv.src = f.src;
          pv.poster = f.poster;
          actual = clave;
        }
        player.setAttribute('aria-label', f.label);
        player.showModal();
        pv.currentTime = 0;
        pv.play().catch(() => undefined);
      }),
    );
    player.querySelector('[data-pclose]')!.addEventListener('click', () => player.close());
    player.addEventListener('close', () => pv.pause());
  }

  // Galería: franja horizontal con flechas
  const strip = document.querySelector<HTMLElement>('[data-strip]');
  if (strip) {
    const prev = document.querySelector<HTMLButtonElement>('[data-strip-prev]')!;
    const next = document.querySelector<HTMLButtonElement>('[data-strip-next]')!;
    const estado = () => {
      prev.disabled = strip.scrollLeft <= 4;
      next.disabled = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4;
    };
    const mover = (dir: number) =>
      strip.scrollBy({ left: dir * Math.max(280, strip.clientWidth * 0.8), behavior: reduce ? 'auto' : 'smooth' });
    prev.addEventListener('click', () => mover(-1));
    next.addEventListener('click', () => mover(1));
    strip.addEventListener('scroll', estado, { passive: true });
    window.addEventListener('resize', estado);
    estado();
  }

  // Galería ampliada con <dialog>: Esc cierra, flechas navegan
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog) {
    const items = [...dialog.querySelectorAll<HTMLElement>('[data-item]')];
    let actual = 0;
    const mostrar = (i: number) => {
      actual = (i + items.length) % items.length;
      items.forEach((el, n) => (el.hidden = n !== actual));
    };
    document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
      b.addEventListener('click', () => {
        mostrar(Number(b.dataset.open));
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => mostrar(actual - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => mostrar(actual + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') mostrar(actual - 1);
      if (e.key === 'ArrowRight') mostrar(actual + 1);
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

