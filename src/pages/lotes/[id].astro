---
import { getImage, Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Icon, { type IconName } from '../../components/Icon.astro';
import PauseButton from '../../components/PauseButton.astro';
import Base from '../../layouts/Base.astro';
import { absoluteUrl, formatArea, formatPrecio, formatPrecioM2, formatTelefono, url } from '../../lib/format';

export async function getStaticPaths() {
  const lotes = await getCollection('lotes');
  return lotes.map((lote) => ({ params: { id: lote.id }, props: { lote } }));
}

interface Props {
  lote: CollectionEntry<'lotes'>;
}

const { lote } = Astro.props;
const d = lote.data;
const lugar = [d.vereda, d.municipio, d.departamento].filter(Boolean).join(', ');
const whatsappUrl = d.contacto
  ? `https://wa.me/${d.contacto.whatsapp}?text=${encodeURIComponent(
      `Hola ${d.contacto.nombre}, vi el ${d.nombre} en Verdelote y quiero agendar una visita`,
    )}`
  : undefined;

// Capítulos del recorrido: arranca en el primero que tenga video
const capitulos = await Promise.all(
  d.recorrido.map(async (c) => ({
    ...c,
    posterUrl: (await getImage({ src: c.poster, width: 1600, format: 'webp' })).src,
  })),
);
const inicial = Math.max(0, capitulos.findIndex((c) => c.video));

// Recorrido completo (opcional): poster optimizado para el reproductor
const completo = d.video_completo
  ? {
      ...d.video_completo,
      posterUrl: (await getImage({ src: d.video_completo.poster, width: 1600, format: 'webp' })).src,
    }
  : undefined;

const cifras = d.cifras ?? [
  { valor: formatArea(d.area_m2), etiqueta: 'Área total' },
  ...(d.explanacion_m2 ? [{ valor: formatArea(d.explanacion_m2), etiqueta: 'Explanados' }] : []),
  { valor: formatPrecio(d.precio_cop), etiqueta: d.estado === 'disponible' ? 'Precio' : `Precio · ${d.estado}` },
];

const iconoAtributo = (texto: string): IconName => {
  const t = texto.toLowerCase();
  if (t.includes('escritur')) return 'scroll';
  if (t.includes('explanaci')) return 'square-half-bottom';
  if (t.includes('riego')) return 'plant';
  if (t.includes('acueducto') || t.includes('agua')) return 'drop';
  if (t.includes('carretera') || t.includes('vía') || t.includes('autopista')) return 'road-horizon';
  if (t.includes('valoriz')) return 'trend-up';
  return 'check-circle';
};

// Cercanías agrupadas por minutos, de la más cercana a la más lejana
const grupos = [...Map.groupBy(d.cercanias, (c) => c.minutos ?? 0)]
  .sort(([a], [b]) => a - b)
  .map(([minutos, items]) => ({ minutos, lugares: items.map((i) => i.lugar) }));

const galeriaVisible = d.galeria.slice(0, 5);

// Vista previa al compartir (WhatsApp, redes): portada recortada a 1200x630
const og = d.portada
  ? await getImage({ src: d.portada, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 })
  : undefined;
const descripcion = `${formatArea(d.area_m2)} en ${d.municipio}, ${d.departamento} por ${formatPrecio(d.precio_cop)}. ${d.resumen}`;

const fichaUrl = absoluteUrl(Astro.url.pathname);
const precioM2 = formatPrecioM2(d.precio_cop, d.area_m2);
const rutaUrl = d.coordenadas
  ? `https://www.google.com/maps/dir/?api=1&destination=${d.coordenadas.lat},${d.coordenadas.lon}`
  : undefined;

// Mensaje listo para pegar en WhatsApp (formato *negrita* de WhatsApp): nombre, tres datos clave, precio y enlace
const datosClave = cifras
  .filter((c) => !/^precio/i.test(c.etiqueta))
  .slice(0, 3)
  .map((c) => `- ${c.valor} ${c.etiqueta.charAt(0).toLowerCase()}${c.etiqueta.slice(1)}`);
const mensajeWhatsapp = [
  `*${d.nombre}*`,
  `${d.municipio}, ${d.departamento}`,
  '',
  ...datosClave,
  '',
  `Precio: ${formatPrecio(d.precio_cop)} (${precioM2})`,
  `Recorrido en video y ficha: ${fichaUrl}`,
].join('\n');

// Datos estructurados: oferta del lote con su lugar (y geo si hay coordenadas).
// Los lotes de demostración no se publican como oferta real
const disponibilidad = {
  disponible: 'https://schema.org/InStock',
  reservado: 'https://schema.org/OutOfStock',
  vendido: 'https://schema.org/SoldOut',
}[d.estado];
const lugarLd = {
  '@type': 'Place',
  name: lugar,
  address: {
    '@type': 'PostalAddress',
    ...(d.vereda && { streetAddress: d.vereda }),
    addressLocality: d.municipio,
    addressRegion: d.departamento,
    addressCountry: 'CO',
  },
  ...(d.coordenadas && {
    geo: { '@type': 'GeoCoordinates', latitude: d.coordenadas.lat, longitude: d.coordenadas.lon },
  }),
};
const fichaLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.nombre,
  description: d.resumen,
  category: 'Lote',
  url: fichaUrl,
  ...(og && { image: [absoluteUrl(og.src)] }),
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Área total', value: d.area_m2, unitCode: 'MTK' },
    ...(d.explanacion_m2
      ? [{ '@type': 'PropertyValue', name: 'Área explanada', value: d.explanacion_m2, unitCode: 'MTK' }]
      : []),
  ],
  offers: {
    '@type': 'Offer',
    url: fichaUrl,
    price: d.precio_cop,
    priceCurrency: 'COP',
    availability: disponibilidad,
    availableAtOrFrom: lugarLd,
  },
};
---

<Base
  title={d.nombre}
  description={descripcion}
  image={og ? absoluteUrl(og.src) : undefined}
  imageAlt={d.nombre}
  jsonLd={d.demo ? undefined : fichaLd}
>
  <div class="localbar no-print" slot="localbar">
    <div class="wrap">
      <a class="back" href={url()} aria-label="Volver a los lotes"><Icon name="caret-left" /><span>Lotes</span></a>
      <span class="name">{d.nombre}</span>
      <div class="right">
        <div class="pricebox">
          <span class="price">{formatPrecio(d.precio_cop)}</span>
          <span class="ppm">{precioM2}</span>
        </div>
        <button
          type="button"
          class="btn btn-ghost share"
          data-share
          data-url={fichaUrl}
          data-title={d.nombre}
          data-text={d.tagline}
          aria-label="Compartir este lote"
        >
          <Icon name="share-network" />
          <span>Compartir</span>
        </button>
        {
          whatsappUrl && (
            <a class="btn btn-primary cta-top" href={whatsappUrl} target="_blank" rel="noopener">
              <Icon name="whatsapp" />
              Agendar visita
            </a>
          )
        }
      </div>
    </div>
  </div>

  <section class="head">
    {d.demo && <p class="demo">Lote de demostración, con datos de ejemplo</p>}
    <h1>{d.nombre}</h1>
    <span class="tag">{d.tagline}</span>
    <div class="where">
      <span class="loc"><Icon name="map-pin" />{lugar}</span>
      {
        rutaUrl && (
          <a class="route" href={rutaUrl} target="_blank" rel="noopener">
            <Icon name="navigation-arrow" />
            Cómo llegar
            <span class="sr-only">(abre Google Maps)</span>
          </a>
        )
      }
      {d.coordenadas?.aproximadas && <span class="approx">Ubicación aproximada</span>}
    </div>
  </section>

  {
    d.portada && (
      <div class="print-only print-cover">
        <Image src={d.portada} alt={d.nombre} widths={[900, 1400]} sizes="720px" loading="lazy" />
      </div>
    )
  }

  <section class="no-print" aria-label="Recorrido" data-recorrido>
    <div class="stage">
      {
        capitulos.length > 0 ? (
          capitulos.map((c, i) =>
            c.video ? (
              <video
                id={`cap-${i}`}
                class="pane"
                data-pane={i}
                hidden={i !== inicial}
                src={url(c.video)}
                poster={c.posterUrl}
                muted
                loop
                playsinline
                autoplay={i === inicial}
                preload={i === inicial ? 'auto' : 'none'}
                aria-label={`Recorrido: ${c.titulo}`}
              />
            ) : (
              <Image
                class="pane"
                data-pane={i}
                hidden={i !== inicial}
                src={c.poster}
                alt={`${c.titulo}: ${c.descripcion}`}
                widths={[800, 1600]}
                sizes="(max-width: 1100px) 100vw, 1200px"
              />
            ),
          )
        ) : d.portada ? (
          <Image class="pane" src={d.portada} alt={d.nombre} widths={[800, 1600]} sizes="(max-width: 1100px) 100vw, 1200px" />
        ) : (
          <div class="pane noimg">
            <Icon name="image" />
            <span>Fotos de ejemplo</span>
          </div>
        )
      }
      {capitulos.some((c) => c.video) && <PauseButton videoId={`cap-${inicial}`} />}
    </div>

    {
      capitulos.length > 1 && (
        <div class="chapters" role="tablist" aria-label="Capítulos del recorrido">
          {capitulos.map((c, i) => (
            <button
              type="button"
              class="chap"
              role="tab"
              aria-selected={i === inicial ? 'true' : 'false'}
              aria-controls={c.video ? `cap-${i}` : undefined}
              data-chap={i}
            >
              <img src={c.posterUrl} alt="" loading="lazy" />
              <div>
                <strong>{c.titulo}</strong>
                <span>
                  {c.video ? <Icon name="play-circle" /> : <Icon name="image" />}
                  {c.video ? 'Video' : 'Foto'}
                </span>
              </div>
            </button>
          ))}
        </div>
      )
    }
  </section>

  <section class="figures" aria-label="Datos clave">
    {
      cifras.map((c) => (
        <div class:list={{ price: /^precio/i.test(c.etiqueta) }}>
          <strong>{c.valor}</strong>
          <span>{c.etiqueta}</span>
        </div>
      ))
    }
  </section>
  <p class="lead">{d.resumen}</p>

  {
    d.atributos.length > 0 && (
      <section class="block">
        <h2>Lo que incluye</h2>
        <div class="includes">
          {d.atributos.map((a) => (
            <div class="inc">
              <Icon name={iconoAtributo(a)} />
              <strong>{a}</strong>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    grupos.length > 0 && (
      <section class="block">
        <h2>Cerca de todo</h2>
        <div class="near">
          {grupos.map((g) => (
            <div class:list={{ wide: g.lugares.length > 2 }}>
              <span class="min">
                {g.minutos}
                <small>min</small>
              </span>
              <ul>
                {g.lugares.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    completo && (
      <section class="block no-print" aria-labelledby="ubicacion-titulo">
        <h2 id="ubicacion-titulo">Ubicación y recorrido</h2>
        <p class="sub">Desde el espacio hasta {d.vereda ? d.vereda.replace(/^Vereda/, 'la vereda') : d.municipio}, en un minuto</p>
        <video
          class="player"
          src={url(completo.src)}
          poster={completo.posterUrl}
          controls
          playsinline
          preload="none"
          aria-label={`Ubicación y recorrido, ${completo.duracion}`}
        />
      </section>
    )
  }

  {
    !completo && !d.demo && d.galeria.length > 0 && (
      <section class="block no-print">
        <h2>Ubicación</h2>
        <div class="map">
          <Image src={d.galeria[Math.min(6, d.galeria.length - 1)].src} alt="" widths={[800, 1600]} sizes="100vw" />
          <div class="over">
            <strong>Vuelo 3D hasta el lote</strong>
            <span>Disponible cuando tengamos el punto exacto en el mapa</span>
          </div>
        </div>
      </section>
    )
  }

  {
    d.galeria.length > 0 && (
      <section class="block no-print">
        <h2>Galería</h2>
        <div class="gallery">
          {galeriaVisible.map((g, i) => {
            const masFotos = i === galeriaVisible.length - 1 && d.galeria.length > galeriaVisible.length;
            return (
              <button
                type="button"
                data-open={i}
                aria-label={masFotos ? `Ver las ${d.galeria.length} fotos` : `Ampliar foto ${i + 1} de ${d.galeria.length}`}
              >
                <Image src={g.src} alt={g.alt} widths={[400, 900]} sizes={i === 0 ? '(max-width: 860px) 100vw, 620px' : '300px'} />
                {masFotos && <span class="more">Ver las {d.galeria.length} fotos</span>}
              </button>
            );
          })}
        </div>

        <dialog class="lightbox" aria-label="Galería de fotos" data-lightbox>
          <button type="button" class="lb-close" data-close aria-label="Cerrar galería">
            <Icon name="x" />
          </button>
          <button type="button" class="lb-nav prev" data-prev aria-label="Foto anterior">
            <Icon name="caret-left" />
          </button>
          {d.galeria.map((g, i) => (
            <figure class="lb-item" data-item={i} hidden>
              <Image src={g.src} alt={g.alt} widths={[900, 1600]} sizes="90vw" loading="lazy" />
              <figcaption>
                {g.alt}
                <span>
                  {i + 1} de {d.galeria.length}
                </span>
              </figcaption>
            </figure>
          ))}
          <button type="button" class="lb-nav next" data-next aria-label="Foto siguiente">
            <Icon name="caret-right" />
          </button>
        </dialog>
      </section>
    )
  }

  {
    whatsappUrl && d.contacto && (
      <section class="closing no-print">
        <div>
          <h2>Conócelo en persona</h2>
          <p>{d.contacto.nombre} responde por WhatsApp y te acompaña al lote</p>
        </div>
        <a class="btn btn-primary" href={whatsappUrl} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          Agendar visita
        </a>
      </section>
    )
  }

  <section class="extras no-print" aria-label="Más opciones">
    <div class="agents">
      <h2>Para agentes</h2>
      <div class="actions">
        {
          d.video_vertical && (
            <a class="btn btn-ghost" href={url(d.video_vertical)} download>
              <Icon name="download-simple" />
              Descargar video vertical para redes
            </a>
          )
        }
        <button type="button" class="btn btn-ghost" data-copy={mensajeWhatsapp} data-copied="Mensaje copiado">
          <Icon name="copy-simple" />
          Copiar mensaje para WhatsApp
        </button>
      </div>
    </div>
    <button type="button" class="btn btn-ghost" data-print>
      <Icon name="file-pdf" />
      Descargar ficha (PDF)
    </button>
  </section>

  <section class="print-only print-contact">
    <h2>Contacto</h2>
    {d.contacto && <p>{d.contacto.nombre}, WhatsApp {formatTelefono(d.contacto.whatsapp)}</p>}
    <p>Ficha en línea: {fichaUrl}</p>
  </section>

  {
    whatsappUrl && (
      <div class="bottombar no-print">
        <div class="bb-price">
          <strong>{formatPrecio(d.precio_cop)}</strong>
          <span>{precioM2}</span>
        </div>
        <a class="btn btn-primary" href={whatsappUrl} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          Agendar visita
        </a>
      </div>
    )
  }
</Base>

<script>
  import { initPrint, initShare } from '../../lib/share';
  import { initPauseButtons } from '../../lib/video-controls';

  initPauseButtons();
  initShare();
  initPrint();

  // Capítulos: cambian el panel visible del visor y reproducen el video si lo hay
  const root = document.querySelector<HTMLElement>('[data-recorrido]');
  const pauseBtn = root?.querySelector<HTMLButtonElement>('[data-pause-for]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // En la tira horizontal (tablet y celular) el capítulo activo queda a la vista sin mover la página
  const tira = root?.querySelector<HTMLElement>('.chapters');
  const centrarCapitulo = (tab: HTMLElement) => {
    if (!tira || tira.scrollWidth <= tira.clientWidth) return;
    const a = tab.getBoundingClientRect();
    const b = tira.getBoundingClientRect();
    tira.scrollTo({
      left: tira.scrollLeft + (a.left - b.left) - (b.width - a.width) / 2,
      behavior: reduce ? 'auto' : 'smooth',
    });
  };
  const activo = root?.querySelector<HTMLElement>('[data-chap][aria-selected="true"]');
  if (activo) centrarCapitulo(activo);
  root?.querySelectorAll<HTMLButtonElement>('[data-chap]').forEach((tab) => {
    tab.addEventListener('click', () => {
      const i = tab.dataset.chap;
      root.querySelectorAll<HTMLElement>('[data-pane]').forEach((pane) => {
        const activo = pane.dataset.pane === i;
        pane.hidden = !activo;
        if (pane instanceof HTMLVideoElement) {
          if (activo && !reduce) pane.play();
          else pane.pause();
        }
      });
      root.querySelectorAll('[data-chap]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      centrarCapitulo(tab);
      const video = root.querySelector<HTMLVideoElement>(`video[data-pane="${i}"]`);
      if (pauseBtn) {
        pauseBtn.hidden = !video;
        if (video) pauseBtn.dataset.pauseFor = video.id;
      }
    });
  });

  // Galería ampliada con <dialog>: Esc cierra, flechas navegan
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog) {
    const items = [...dialog.querySelectorAll<HTMLElement>('[data-item]')];
    let actual = 0;
    const mostrar = (i: number) => {
      actual = (i + items.length) % items.length;
      items.forEach((el, n) => (el.hidden = n !== actual));
    };
    document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
      b.addEventListener('click', () => {
        mostrar(Number(b.dataset.open));
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => mostrar(actual - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => mostrar(actual + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') mostrar(actual - 1);
      if (e.key === 'ArrowRight') mostrar(actual + 1);
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  /* Las anclas y el foco con teclado no quedan bajo la barra fija; sin scroll de fondo con la galería abierta */
  :global(html) {
    scroll-padding-top: 76px;
    scrollbar-gutter: stable;
  }
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }

  .localbar {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
  }
  .localbar .wrap {
    height: 60px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .name {
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pricebox {
    display: grid;
    justify-items: end;
    margin-right: 8px;
    line-height: 1.25;
  }
  .price {
    font-weight: 500;
    white-space: nowrap;
  }
  .ppm {
    color: var(--muted);
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .localbar .btn {
    height: 44px;
    padding: 0 18px;
    font-size: 0.875rem;
  }

  .bottombar {
    display: none;
  }

  .head {
    display: grid;
    gap: 10px;
    padding: 40px 0 28px;
  }
  .demo {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  h1 {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    line-height: 1.02;
  }
  .tag {
    color: var(--muted);
    font-size: 1.375rem;
    letter-spacing: -0.01em;
  }
  .where {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
    font-size: 0.9375rem;
  }
  .loc,
  .route {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .loc {
    color: var(--muted);
  }
  .route {
    color: var(--accent);
    font-weight: 500;
  }
  .route:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .approx {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 72vh;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  .stage :global(.pane) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .stage :global(.pane[hidden]) {
    display: none;
  }
  .stage :global(.pause[hidden]) {
    display: none;
  }
  .chapters {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 16px;
  }
  .chap {
    display: grid;
    grid-template-columns: 96px 1fr;
    align-items: center;
    gap: 14px;
    min-height: 84px;
    padding: 10px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .chap img {
    width: 96px;
    height: 64px;
    object-fit: cover;
    border-radius: 10px;
  }
  .chap strong {
    display: block;
    font-weight: 500;
  }
  .chap span {
