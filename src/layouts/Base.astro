---
import Icon from '../components/Icon.astro';
import { absoluteUrl, url } from '../lib/format';
import '../styles/global.css';

interface Props {
  /** Título de la página sin la marca; se arma como "Título · Verdelote" */
  title?: string;
  description?: string;
  /** URL absoluta de la imagen para la vista previa al compartir (1200x630) */
  image?: string;
  imageAlt?: string;
  /** Datos estructurados schema.org (uno o varios nodos) */
  jsonLd?: object | object[];
  /** Páginas que no deben indexarse ni llevar canónica (404) */
  noindex?: boolean;
  /** overlay: navegación transparente sobre una portada a pantalla completa; solid: barra con fondo propio */
  nav?: 'overlay' | 'solid';
}

const SITE_NAME = 'Verdelote';
const {
  title,
  description = 'Lotes en Antioquia con recorrido en video, datos claros y contacto directo con el dueño',
  image = absoluteUrl(url('og-default.png')),
  imageAlt = 'Verdelote, lotes en Antioquia',
  jsonLd,
  noindex = false,
  nav = 'solid',
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · Lotes en Antioquia con recorrido en video`;
const canonical = absoluteUrl(Astro.url.pathname);
const nodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// "<" escapado para que el JSON nunca cierre la etiqueta script
const ldJson = (node: object) => JSON.stringify(node).replace(/</g, '\\u003c');
---

<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0c0d" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {nodes.map((node) => <script type="application/ld+json" set:html={ldJson(node)} />)}
  </head>
  <body>
    <header class:list={['nav', 'no-print', { solid: nav === 'solid' }]} id="nav" data-nav>
      <div class="wrap">
        <a class="brand" href={url()}><Icon name="mountains" />Verdelote</a>
        <nav aria-label="Principal">
          <a href={url('#lotes')} aria-current={Astro.url.pathname === url('/') ? 'page' : undefined}>Lotes</a>
        </nav>
        <div class="right"><slot name="nav-right" /></div>
      </div>
    </header>
    <slot name="localbar" />
    <main class:list={{ 'with-nav': nav === 'solid' }}>
      <slot />
    </main>
    <footer class="wrap site-footer">
      <p>Verdelote · Prototipo</p>
    </footer>
    <div class="toast" role="status" aria-live="polite" data-toast></div>
  </body>
</html>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    transition: background 0.4s, backdrop-filter 0.4s, opacity 0.35s, visibility 0.35s;
  }
  .nav.solid {
    background: rgb(11 12 13 / 0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--line);
  }
  .nav .wrap {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
  .brand :global(.icon) {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--accent);
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    color: rgb(244 245 243 / 0.78);
    font-size: 0.9375rem;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }
  .right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  main.with-nav {
    padding-top: var(--nav-h);
  }
  .site-footer {
    padding-top: 56px;
    padding-bottom: 56px;
    color: var(--muted);
    font-size: 0.875rem;
  }
  @media (max-width: 700px) {
    .nav .wrap {
      gap: 16px;
    }
    nav {
      display: none;
    }
  }
  @media print {
    .site-footer {
      display: none;
    }
  }
</style>
