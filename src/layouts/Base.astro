---
import Icon from '../components/Icon.astro';
import { url } from '../lib/format';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Verdelote',
  description = 'Lotes en Antioquia con recorrido virtual',
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{title}</title>
  </head>
  <body>
    <header class="wrap site-nav">
      <a class="brand" href={url()}><Icon name="mountains" />Verdelote</a>
      <nav aria-label="Principal">
        <a href={url()} aria-current={Astro.url.pathname === url('/') ? 'page' : undefined}>Lotes</a>
      </nav>
    </header>
    <slot name="localbar" />
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <p>Verdelote · Prototipo</p>
    </footer>
  </body>
</html>

<style>
  .site-nav {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
  .brand :global(.icon) {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--accent);
  }
  nav a {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  nav a[aria-current='page'] {
    color: var(--text);
  }
  .site-footer {
    padding-top: 48px;
    padding-bottom: 48px;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
