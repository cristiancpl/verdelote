---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import marca from '../assets/marca/am-marca-claro.png';
import { absoluteUrl, formatTelefono, url } from '../lib/format';
import '../styles/global.css';

interface Props {
  /** Título de la página sin la marca; se arma como "Título · AM Grupo Inmobiliario" */
  title?: string;
  description?: string;
  /** URL absoluta de la imagen para la vista previa al compartir (1200x630) */
  image?: string;
  imageAlt?: string;
  /** Datos estructurados schema.org (uno o varios nodos) */
  jsonLd?: object | object[];
  /** Páginas que no deben indexarse ni llevar canónica (404) */
  noindex?: boolean;
  /** overlay: navegación transparente sobre una portada a pantalla completa; solid: barra con fondo propio */
  nav?: 'overlay' | 'solid';
}

const SITE_NAME = 'AM Grupo Inmobiliario';
// Contacto general del sitio (botón "Agendar visita" del menú y pie de página)
const CONTACTO = { nombre: 'Andrés', whatsapp: '573216953286' };
const whatsappGeneral = `https://wa.me/${CONTACTO.whatsapp}?text=${encodeURIComponent(
  `Hola ${CONTACTO.nombre}, vi los lotes de ${SITE_NAME} y quiero agendar una visita`,
)}`;
// Municipios con lotes: el pie los enlaza al listado ya filtrado
const municipios = [...new Set((await getCollection('lotes')).map((l) => l.data.municipio))].sort((a, b) =>
  a.localeCompare(b, 'es'),
);
const enInicio = Astro.url.pathname === url('/');
const {
  title,
  description = 'Lotes en Antioquia con recorrido en video, datos claros y contacto directo con el dueño',
  image = absoluteUrl(url('og-default.png')),
  imageAlt = 'AM Grupo Inmobiliario, lotes en Antioquia',
  jsonLd,
  noindex = false,
  nav = 'solid',
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · Lotes en Antioquia con recorrido en video`;
const canonical = absoluteUrl(Astro.url.pathname);
const nodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// "<" escapado para que el JSON nunca cierre la etiqueta script
const ldJson = (node: object) => JSON.stringify(node).replace(/</g, '\\u003c');
---

<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0c0d" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {nodes.map((node) => <script type="application/ld+json" set:html={ldJson(node)} />)}
  </head>
  <body>
    <header class:list={['nav', 'no-print', { solid: nav === 'solid' }]} id="nav" data-nav>
      <div class="wrap">
        <a class="brand" href={url()} aria-label={`${SITE_NAME}, inicio`}>
          <Image src={marca} alt="" width={66} height={32} densities={[1, 2, 3]} />
          <span>Grupo Inmobiliario</span>
        </a>
        <nav aria-label="Principal">
          <a href={url()} aria-current={enInicio ? 'page' : undefined}>Explorar</a>
          <a href={url('lotes/')} aria-current={Astro.url.pathname === url('lotes/') ? 'page' : undefined}>Lotes</a>
          <a href={url('lotes/#contacto')}>Contacto</a>
        </nav>
        <div class="right">
          <slot name="nav-right">
            <a class="btn btn-glass btn-sm" href={whatsappGeneral} target="_blank" rel="noopener">Agendar visita</a>
          </slot>
        </div>
      </div>
    </header>
    <slot name="localbar" />
    <main class:list={{ 'with-nav': nav === 'solid' }}>
      <slot />
    </main>
    <footer class="site-footer no-print" id="contacto">
      <div class="wrap">
        <div class="cols">
          <div class="about">
            <Image src={marca} alt={SITE_NAME} width={66} height={32} densities={[1, 2, 3]} />
            <p>Lotes campestres en Antioquia, con recorrido en video y mapa 3D</p>
          </div>
          <div>
            <h2>Explorar</h2>
            <ul>
              <li><a href={url()}>Explorar en 3D</a></li>
              <li><a href={url('lotes/')}>Lotes</a></li>
            </ul>
          </div>
          <div>
            <h2>Zonas</h2>
            <ul>
              {municipios.map((m) => (
                <li>
                  <a href={url(`lotes/?municipio=${encodeURIComponent(m)}#lotes`)}>{m}</a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h2>Contacto</h2>
            <ul>
              <li>
                <a href={whatsappGeneral} target="_blank" rel="noopener">WhatsApp {formatTelefono(CONTACTO.whatsapp)}</a>
              </li>
              <li>Atiende {CONTACTO.nombre}</li>
            </ul>
          </div>
        </div>
        <div class="legal">
          <span>© {new Date().getFullYear()} {SITE_NAME}</span>
          <span>Áreas y ubicaciones aproximadas, sujetas a verificación en escrituras</span>
        </div>
      </div>
    </footer>
    <div class="toast" role="status" aria-live="polite" data-toast></div>
  </body>
</html>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    transition: background 0.4s, backdrop-filter 0.4s, opacity 0.35s, visibility 0.35s;
  }
  .nav.solid {
    background: rgb(11 12 13 / 0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--line);
  }
  .nav .wrap {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
  .brand {
    gap: 12px;
  }
  .brand img {
    height: 32px;
    width: auto;
  }
  .brand span {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgb(244 245 243 / 0.82);
  }
  nav {
    display: flex;
    gap: 28px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    color: rgb(244 245 243 / 0.78);
    font-size: 0.9375rem;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }
  .right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  main.with-nav {
    padding-top: var(--nav-h);
  }
  .site-footer {
    padding: 56px 0 40px;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
  }
  .cols {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 32px;
  }
  .about img {
    height: 32px;
    width: auto;
  }
  .about p {
    max-width: 32ch;
    margin-top: 14px;
    color: var(--muted);
    line-height: 1.5;
  }
  .site-footer h2 {
    margin-bottom: 10px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .site-footer li a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }
  .site-footer li a:hover {
    color: var(--accent);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 40px;
    font-size: 0.75rem;
    color: #8a908c;
  }
  @media (max-width: 1100px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 700px) {
    .nav .wrap {
      gap: 16px;
    }
    nav {
      display: none;
    }
  }
  @media print {
    .site-footer {
      display: none;
    }
  }
</style>
