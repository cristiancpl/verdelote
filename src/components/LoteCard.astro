---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { nombreCorto, url } from '../lib/format';
import { textoArea, textoPrecio, tieneRecorrido } from '../lib/lote';
import Icon from './Icon.astro';

interface Props {
  lote: CollectionEntry<'lotes'>;
  /** Lote destacado: la tarjeta existe para los filtros y se oculta mientras no haya filtros activos */
  featured?: boolean;
}

const { lote, featured = false } = Astro.props;
const d = lote.data;
const conRecorrido = tieneRecorrido(d);
const lugar = [d.vereda, d.municipio].filter(Boolean).join(', ');
// Etiquetas: lotes de la parcelación (en dorado) y los dos primeros atributos
const etiquetas = d.atributos.filter((a) => !/parcelaci/i.test(a)).slice(0, 2);
---

<a
  class="card"
  href={url(`lotes/${lote.id}/`)}
  data-lote
  data-featured={featured ? '' : undefined}
  hidden={featured}
  data-municipio={d.municipio}
  data-area={d.area_m2}
  data-precio={d.precio_cop ?? 0}
  data-recorrido={conRecorrido ? '1' : '0'}
  data-unidades={d.unidades.length || 1}
>
  {
    d.portada ? (
      <div class="img">
        <Image src={d.portada} alt={d.nombre} widths={[640, 1000, 1400]} sizes="(max-width: 700px) 100vw, (max-width: 1320px) 50vw, 640px" />
      </div>
    ) : (
      <div class="img noimg">
        <Icon name="image" />
        <span>Fotos de ejemplo</span>
      </div>
    )
  }
  <div class="body">
    <div class="meta">
      <h3>{nombreCorto(d.nombre)}</h3>
      <span class="price">{textoPrecio(d)}</span>
    </div>
    <p class="sub">
      {lugar} · {textoArea(d)}
      {d.estado !== 'disponible' && <span class="estado"> · {d.estado}</span>}
    </p>
    <ul class="tags">
      {d.unidades.length > 0 && <li class="gold">{d.unidades.length} lotes</li>}
      {d.unidades.length > 0 && <li>Parcelación</li>}
      {etiquetas.map((t) => <li>{t}</li>)}
      {
        conRecorrido && (
          <li class="tour">
            <Icon name="play-circle" />
            Video
          </li>
        )
      }
      {d.demo && <li>Demo</li>}
    </ul>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: 24px;
    overflow: hidden;
    background: var(--bg-2);
    transition: background 0.3s;
  }
  .card:hover {
    background: color-mix(in srgb, var(--bg-2) 85%, #fff);
  }
  .card[hidden] {
    display: none;
  }
  .img {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--card);
  }
  .img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .card:hover .img img {
    transform: scale(1.03);
  }
  .noimg {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    color: var(--muted);
  }
  .body {
    display: grid;
    gap: 10px;
    padding: 22px 26px 26px;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  h3 {
    font-size: clamp(1.25rem, 1.8vw, 1.625rem);
    letter-spacing: -0.025em;
  }
  .price {
    font-size: clamp(1rem, 1.3vw, 1.1875rem);
    font-weight: 600;
    white-space: nowrap;
  }
  .sub {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .estado {
    text-transform: capitalize;
  }
  .tags {
    list-style: none;
    margin: 2px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags li {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 11px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.07);
    font-size: 0.8125rem;
  }
  .tags .gold,
  .tags .tour {
    color: var(--accent);
    background: rgb(183 143 84 / 0.12);
  }
  @media (max-width: 1100px) {
    .meta {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
