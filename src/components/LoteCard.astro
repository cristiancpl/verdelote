---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatArea, formatPrecio, nombreCorto, url } from '../lib/format';
import { tieneRecorrido } from '../lib/lote';
import Icon from './Icon.astro';

interface Props {
  lote: CollectionEntry<'lotes'>;
  /** Lote destacado: la tarjeta existe para los filtros y se oculta mientras no haya filtros activos */
  featured?: boolean;
}

const { lote, featured = false } = Astro.props;
const d = lote.data;
const conRecorrido = tieneRecorrido(d);
---

<a
  class="card"
  href={url(`lotes/${lote.id}/`)}
  data-lote
  data-featured={featured ? '' : undefined}
  hidden={featured}
  data-municipio={d.municipio}
  data-area={d.area_m2}
  data-precio={d.precio_cop}
  data-recorrido={conRecorrido ? '1' : '0'}
>
  {
    d.portada ? (
      <div class="img">
        <Image src={d.portada} alt={d.nombre} widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 400px" />
      </div>
    ) : (
      <div class="img noimg">
        <Icon name="image" />
        <span>Fotos de ejemplo</span>
      </div>
    )
  }
  <div class="meta">
    <h3>{nombreCorto(d.nombre)}</h3>
    <span class="price">{formatPrecio(d.precio_cop)}</span>
  </div>
  <div class="sub">
    <span>
      {d.municipio} · {formatArea(d.area_m2)}{d.estado !== 'disponible' && <span class="estado"> · {d.estado}</span>}
    </span>
    {conRecorrido && <span class="tour"><Icon name="play-circle" />Recorrido en video</span>}
    {d.demo && <span class="demo">Demo</span>}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
  }
  .card[hidden] {
    display: none;
  }
  .img {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--card);
  }
  .img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .card:hover .img img {
    transform: scale(1.04);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 14px;
  }
  h3 {
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
  .price {
    font-weight: 500;
    white-space: nowrap;
  }
  .sub {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .estado {
    text-transform: capitalize;
  }
  .tour {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-weight: 500;
  }
  .demo {
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
  }
</style>
