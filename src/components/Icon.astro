---
// Íconos de Phosphor (@phosphor-icons/core) incrustados como SVG; solo se empaquetan los que se usan
import arrowsOut from '@phosphor-icons/core/regular/arrows-out.svg?raw';
import caretLeft from '@phosphor-icons/core/regular/caret-left.svg?raw';
import caretRight from '@phosphor-icons/core/regular/caret-right.svg?raw';
import checkCircle from '@phosphor-icons/core/regular/check-circle.svg?raw';
import copySimple from '@phosphor-icons/core/regular/copy-simple.svg?raw';
import downloadSimple from '@phosphor-icons/core/regular/download-simple.svg?raw';
import filePdf from '@phosphor-icons/core/regular/file-pdf.svg?raw';
import drop from '@phosphor-icons/core/regular/drop.svg?raw';
import image from '@phosphor-icons/core/regular/image.svg?raw';
import mapPin from '@phosphor-icons/core/regular/map-pin.svg?raw';
import navigationArrow from '@phosphor-icons/core/regular/navigation-arrow.svg?raw';
import mountains from '@phosphor-icons/core/fill/mountains-fill.svg?raw';
import pause from '@phosphor-icons/core/fill/pause-fill.svg?raw';
import plant from '@phosphor-icons/core/regular/plant.svg?raw';
import play from '@phosphor-icons/core/regular/play.svg?raw';
import playFill from '@phosphor-icons/core/fill/play-fill.svg?raw';
import playCircle from '@phosphor-icons/core/fill/play-circle-fill.svg?raw';
import roadHorizon from '@phosphor-icons/core/regular/road-horizon.svg?raw';
import scroll from '@phosphor-icons/core/regular/scroll.svg?raw';
import shareNetwork from '@phosphor-icons/core/regular/share-network.svg?raw';
import squareHalfBottom from '@phosphor-icons/core/regular/square-half-bottom.svg?raw';
import trendUp from '@phosphor-icons/core/regular/trend-up.svg?raw';
import whatsapp from '@phosphor-icons/core/regular/whatsapp-logo.svg?raw';
import x from '@phosphor-icons/core/regular/x.svg?raw';

const icons = {
  'arrows-out': arrowsOut,
  'caret-left': caretLeft,
  'caret-right': caretRight,
  'check-circle': checkCircle,
  'copy-simple': copySimple,
  'download-simple': downloadSimple,
  'file-pdf': filePdf,
  drop,
  image,
  'map-pin': mapPin,
  'navigation-arrow': navigationArrow,
  mountains,
  pause,
  plant,
  play,
  'play-fill': playFill,
  'play-circle': playCircle,
  'road-horizon': roadHorizon,
  scroll,
  'share-network': shareNetwork,
  'square-half-bottom': squareHalfBottom,
  'trend-up': trendUp,
  whatsapp,
  x,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = '' } = Astro.props;
const svg = icons[name].replace('<svg ', `<svg class="icon ${className}" aria-hidden="true" focusable="false" `);
---

<Fragment set:html={svg} />
